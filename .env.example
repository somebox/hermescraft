# Local secrets — copy to .env and fill in. .env is gitignored.
#
# Consumed by:
#   - bot/lib/bot/paper-mcp.js (PAPERMCP_TOKEN)
#   - scripts/g21-orchestrator.py
#   - scripts/landfolk-bodies-only.sh, scripts/landfolk-control.sh
#
# Anthropic/OpenRouter keys are sourced separately from $HOME/.hermes/.env
# by the launch scripts; they do not belong here.

PAPERMCP_TOKEN=<get_from_paper_plugin_config>
