#!/usr/bin/env python3
"""kanban — write-side facade over `hermes kanban` for the landfolk-ops board.

Why this exists
---------------
The `hermes kanban` CLI's `--parent` flag carries two semantically distinct
meanings — real domain prerequisite vs. epic-tracking bookkeeping — that the
gate-check (`_undone_parents_exist`) cannot tell apart. Agents (and humans)
routinely conflate them. The result, observed multiple times in genesis runs,
is that an epic stays `ready` forever (it's the orchestrator's continuous
queue card) while its title-mate "children" stay `todo` waiting for the
epic to be `done` — which it never will be. Dispatcher idle.

This wrapper splits `--parent` into two:

  --depends-on <id>   real prerequisite. Writes a task_links edge. The
                      child cannot promote until the parent is done.
  --epic <id>         membership only. Writes a body-trailer tag, NOT a
                      link. The child promotes immediately; the epic
                      tracks its kids by tag, not by edge.

Plus a small set of explicit dependency verbs so the relationship is named
in commands instead of inferred from `--parent`:

  depends-add <child> <parent>
  depends-remove <child> <parent>
  dependencies <id>           # both directions, with status

The facade also normalizes status-change verbs (`complete`, `block`,
`unblock`, `reassign`, `comment`, `archive`) so SOULs and skills can refer
to one verb set that's stable across Hermes upgrades.

Implementation
--------------
- READS go direct to ~/.hermes/kanban/boards/<board>/kanban.db (read-only
  SQLite). Faster than shelling out, and lets us join task_links with
  task status in a single query.
- WRITES shell out to `hermes kanban` so the events table, claim_lock
  parking, and recompute_ready cascades all stay consistent.

Coexistence
-----------
Raw `hermes kanban` remains callable for ad-hoc ops. SOULs and skills
should reference this facade. Future move (not yet): a sandbox PATH stub
that blocks `--parent` to make the bug class structurally impossible
even from raw shells.

Usage
-----
  scripts/kanban create "<title>" --assignee X
                       [--epic <id>] [--depends-on <id>]...
                       [--body "..."] [--priority N] [--skill ...]
                       [--triage] [--json]
  scripts/kanban list [--status X] [--assignee Y] [--epic Z]
  scripts/kanban show <id>
  scripts/kanban complete <id> [--result "..."]
  scripts/kanban block <id> [--reason "..."]
  scripts/kanban unblock <id>
  scripts/kanban reassign <id> <new_assignee>
  scripts/kanban assign <id> <profile>           # alias of reassign
  scripts/kanban comment <id> "<text>"
  scripts/kanban archive <id> [<id>...]
  scripts/kanban depends-add <child> <parent>
  scripts/kanban depends-remove <child> <parent>
  scripts/kanban dependencies <id>
  scripts/kanban epic-of <id>
  scripts/kanban epic <epic_id>                  # show epic + its children
  scripts/kanban list-epics
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
from pathlib import Path
from typing import Optional

REPO_ROOT = Path(__file__).resolve().parent.parent


def _real_user_home() -> Path:
    """Return the invoking user's OS-level home directory, not the value of
    `$HOME`. Hermes profiles override `$HOME` (e.g. steward → `~/.hermes/
    profiles/steward/home/`) for tool-call isolation; `Path.home()` follows
    that override, which makes the default DB path resolve under the profile
    home where no kanban DB actually lives. The dispatcher works around it
    by setting `HERMES_KANBAN_DB` explicitly; this fallback fixes the case
    where someone runs `steward chat` / `flint chat` interactively without
    that env var set."""
    try:
        import pwd
        return Path(pwd.getpwuid(os.getuid()).pw_dir)
    except (ImportError, KeyError):
        # Windows or sandbox where getpwuid fails — fall back to $HOME.
        return Path.home()


BOARD = os.environ.get("HERMES_KANBAN_BOARD", "landfolk-ops")
DB_PATH = Path(
    os.environ.get(
        "HERMES_KANBAN_DB",
        str(_real_user_home() / ".hermes" / "kanban" / "boards" / BOARD / "kanban.db"),
    )
)

EPIC_TRAILER_RE = re.compile(r"^---\s*\nepic:\s*(\S+)\s*$", re.MULTILINE)


# ─── shared helpers ─────────────────────────────────────────────────────────


def _die(msg: str, code: int = 1) -> None:
    print(f"kanban: {msg}", file=sys.stderr)
    sys.exit(code)


def _run(cmd: list[str], timeout: int = 30) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def _hermes(*args: str, timeout: int = 30, json_flag: bool = False) -> dict | list | str:
    """Run `hermes kanban --board <board> <args>`. Returns parsed JSON if json_flag,
    else raw stdout. Raises on non-zero exit (prints stderr first)."""
    cmd = ["hermes", "kanban", "--board", BOARD, *args]
    if json_flag and "--json" not in args:
        cmd.append("--json")
    proc = _run(cmd, timeout=timeout)
    if proc.returncode != 0:
        msg = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        _die(f"hermes kanban {' '.join(args[:2])} failed: {msg}", code=proc.returncode or 1)
    if json_flag:
        try:
            return json.loads(proc.stdout)
        except json.JSONDecodeError as e:
            _die(f"hermes returned non-JSON: {e}: {proc.stdout[:200]}")
    return proc.stdout


def _db() -> sqlite3.Connection:
    if not DB_PATH.exists():
        _die(f"kanban DB not found at {DB_PATH} — is the board initialized?")
    # Plain open (not the `mode=ro` URI form). Read-only is a soft
    # contract here — none of our queries write — but the URI form
    # rejects opens with "unable to open database file" when the
    # WAL/SHM sidecars are mid-transition right after a writer commits.
    # Observed g-2026-05-29-5 at 01:44:32 (4s after landfolk_start, right
    # after seed_cards). The plain open path lets SQLite cooperate with
    # the WAL the normal way and the call succeeds.
    conn = sqlite3.connect(str(DB_PATH), timeout=5.0)
    conn.row_factory = sqlite3.Row
    return conn


def _db_rw() -> sqlite3.Connection:
    """Read-write connection for verbs Hermes doesn't expose (promote,
    set-priority, in-flight edit). Use sparingly; most state transitions
    should still shell out to `hermes kanban …` so event-table cascades
    and claim-lock parking stay consistent."""
    if not DB_PATH.exists():
        _die(f"kanban DB not found at {DB_PATH}")
    conn = sqlite3.connect(str(DB_PATH), isolation_level=None, timeout=10.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys=ON")
    return conn


def _write_event(conn: sqlite3.Connection, task_id: str, kind: str,
                 payload: Optional[dict] = None) -> None:
    """Append a task_events row. Mirrors upstream `_append_event` shape so
    the dashboard and `hermes kanban watch` see our writes."""
    import time as _time
    conn.execute(
        "INSERT INTO task_events (task_id, kind, payload, created_at) "
        "VALUES (?, ?, ?, ?)",
        (task_id, kind, json.dumps(payload) if payload else None, int(_time.time())),
    )


VALID_SIZES = ("S", "M", "L", "XL")
DEFAULT_SIZE = "M"


def _validate_size(value: Optional[str]) -> Optional[str]:
    if value is None:
        return None
    v = value.strip().upper()
    if v not in VALID_SIZES:
        _die(f"--size must be one of {VALID_SIZES}, got {value!r}")
    return v


def _parse_location(value: Optional[str]) -> tuple[Optional[int], Optional[int], Optional[int]]:
    """Parse ``X,Y,Z`` into a tuple of ints. Returns (None, None, None)
    if value is falsy."""
    if not value:
        return (None, None, None)
    parts = [p.strip() for p in value.split(",")]
    if len(parts) != 3:
        _die(f"--at must be X,Y,Z (three signed integers), got {value!r}")
    try:
        return (int(parts[0]), int(parts[1]), int(parts[2]))
    except ValueError:
        _die(f"--at coordinates must be integers, got {value!r}")
    return (None, None, None)  # unreachable; satisfies type


# ─── epic trailer parsing ───────────────────────────────────────────────────


def _split_body_trailer(body: str) -> tuple[str, dict[str, str]]:
    """Split a body string into (visible_body, trailer_dict).

    The trailer is a single `---\\n` separator followed by YAML-ish `key: value`
    lines at the END of the body. We only recognize a small fixed set of keys
    (`epic`, `genesis_run`) — anything else gets folded back into the body.
    """
    if "---" not in (body or ""):
        return body or "", {}
    parts = (body or "").rsplit("\n---\n", 1)
    if len(parts) != 2:
        # Also accept leading `---\n` if body starts with the trailer (rare)
        if (body or "").startswith("---\n"):
            parts = ["", body[4:]]
        else:
            return body or "", {}
    visible, trailer_block = parts[0], parts[1]
    trailer: dict[str, str] = {}
    for line in trailer_block.splitlines():
        line = line.strip()
        if not line or ":" not in line:
            continue
        k, _, v = line.partition(":")
        k = k.strip()
        v = v.strip()
        if k in ("epic", "genesis_run"):
            trailer[k] = v
    if not trailer:
        return body or "", {}
    return visible.rstrip("\n"), trailer


def _epic_of(body: Optional[str]) -> Optional[str]:
    if not body:
        return None
    _, trailer = _split_body_trailer(body)
    return trailer.get("epic")


def _attach_trailer(body: str, epic: Optional[str], genesis_run: Optional[str] = None) -> str:
    """Append (or replace) a trailer block at the end of body."""
    visible, existing = _split_body_trailer(body or "")
    merged = dict(existing)
    if epic is not None:
        merged["epic"] = epic
    if genesis_run is not None:
        merged["genesis_run"] = genesis_run
    if not merged:
        return visible
    lines = [f"{k}: {v}" for k, v in merged.items()]
    sep = "\n\n" if visible else ""
    return f"{visible}{sep}---\n" + "\n".join(lines)


# ─── DB queries ─────────────────────────────────────────────────────────────


def _fetch_task(conn: sqlite3.Connection, task_id: str) -> Optional[sqlite3.Row]:
    return conn.execute(
        "SELECT id, title, body, assignee, status, priority, claim_lock, created_at, completed_at "
        "FROM tasks WHERE id = ?",
        (task_id,),
    ).fetchone()


def _fetch_parents(conn: sqlite3.Connection, task_id: str) -> list[sqlite3.Row]:
    return list(
        conn.execute(
            """
            SELECT p.id, p.title, p.status, p.assignee
            FROM task_links l JOIN tasks p ON p.id = l.parent_id
            WHERE l.child_id = ?
            ORDER BY p.created_at
            """,
            (task_id,),
        )
    )


def _fetch_children(conn: sqlite3.Connection, task_id: str) -> list[sqlite3.Row]:
    return list(
        conn.execute(
            """
            SELECT c.id, c.title, c.status, c.assignee
            FROM task_links l JOIN tasks c ON c.id = l.child_id
            WHERE l.parent_id = ?
            ORDER BY c.created_at
            """,
            (task_id,),
        )
    )


def _all_tasks(conn: sqlite3.Connection, status: Optional[str], assignee: Optional[str]) -> list[sqlite3.Row]:
    where = []
    params: list = []
    if status:
        statuses = [s.strip() for s in status.split(",") if s.strip()]
        where.append(f"status IN ({','.join('?' * len(statuses))})")
        params.extend(statuses)
    if assignee:
        where.append("lower(coalesce(assignee, '')) = lower(?)")
        params.append(assignee)
    sql = "SELECT id, title, body, assignee, status, priority, claim_lock FROM tasks"
    if where:
        sql += " WHERE " + " AND ".join(where)
    sql += " ORDER BY priority DESC, created_at"
    return list(conn.execute(sql, params))


def _scan_epic_children(conn: sqlite3.Connection, epic_id: str) -> list[sqlite3.Row]:
    """Return all cards whose body trailer references this epic.

    Scans every task body. The board is small (hundreds of cards lifetime);
    if this gets slow we add a `body LIKE '%epic: <id>%'` prefilter.
    """
    candidates = conn.execute(
        "SELECT id, title, body, assignee, status, priority FROM tasks "
        "WHERE body LIKE ? ORDER BY priority DESC, created_at",
        (f"%epic: {epic_id}%",),
    ).fetchall()
    out = []
    for row in candidates:
        if _epic_of(row["body"]) == epic_id:
            out.append(row)
    return out


# ─── command: create ────────────────────────────────────────────────────────


def cmd_lint(args: argparse.Namespace) -> int:
    """Phase 10 PR-R — ad-hoc card-body lint. Lets Steward (or an
    operator) validate a body BEFORE invoking `kanban_create` or any
    other write path. Exits 0 on pass, 1 on lint error."""
    if str(REPO_ROOT) not in sys.path:
        sys.path.insert(0, str(REPO_ROOT))
    from scripts.lib.card_body_linter import lint_card_body
    body = args.body
    if args.body_file:
        body = args.body_file.read_text(encoding="utf-8")
    result = lint_card_body(kind=args.kind, title=args.title, body=body)
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        status = "ok" if result["ok"] else "FAIL"
        print(f"lint {status}: kind={result['kind']!r} verb_count={result['verb_count']} coord_count={result['coord_count']}")
        for err in result["errors"]:
            print(f"  ERROR: {err}")
        for w in result["warnings"]:
            print(f"  warn: {w}")
    return 0 if result["ok"] else 1


def cmd_create(args: argparse.Namespace) -> int:
    """Create a new card. NO --parent flag — use --epic (no gate) or
    --depends-on (real prerequisite gate)."""

    body = args.body or ""
    if body:
        if str(REPO_ROOT) not in sys.path:
            sys.path.insert(0, str(REPO_ROOT))
        from scripts.lib.playbook_registry import validate_card_body_playbook
        pb_err = validate_card_body_playbook(body)
        if pb_err:
            _die(pb_err)
    # Phase 10 PR-R — dispatch-time card-body linter. Reject malformed
    # CONSTRUCT/MINE/TILL/SUPPLY/SURVEY cards before they enter `ready`.
    # Phase 9 evidence: workers' prose-card-escalate (PR-B) got 0
    # invocations because the worker decision loop can't reliably
    # distinguish "I should escalate" from "I should try harder". Move
    # the check upstream so workers never see the malformed card.
    if not getattr(args, "allow_prose", False):
        if str(REPO_ROOT) not in sys.path:
            sys.path.insert(0, str(REPO_ROOT))
        from scripts.lib.card_body_linter import lint_card_body
        lint = lint_card_body(kind=None, title=args.title, body=body)
        if not lint["ok"]:
            msg = "; ".join(lint["errors"])
            _die(
                f"card body lint failed: {msg}\n"
                f"  Pass --allow-prose if you intentionally want a prose-only card "
                f"(rare — usually means the body needs a literal mc verb line)."
            )
    if args.epic:
        # Validate epic exists before tagging — silent typos are the
        # opposite of the cognitive clarity this facade is trying to buy.
        with _db() as conn:
            row = _fetch_task(conn, args.epic)
        if row is None:
            _die(f"--epic {args.epic} does not exist on board {BOARD}")
        body = _attach_trailer(body, epic=args.epic)

    # Refuse --depends-on against an [EPIC]-titled card. Symmetric to the
    # sandbox block on raw `hermes kanban create --parent`. Observed
    # g-2026-05-28-5: Steward filed FIX with `--depends-on t_<P1_epic>`,
    # which wedged the card in todo because orchestrator-continuous epics
    # never reach `done`. The right flag for epic membership is `--epic`;
    # `--depends-on` is for real per-card prereqs (e.g. SUPPLY depends-on
    # SCOUT's registered mark). Catch the mistake at write time rather
    # than letting the dispatcher fail-silent.
    if args.depends_on:
        with _db() as conn:
            for parent_id in args.depends_on:
                parent_row = _fetch_task(conn, parent_id)
                if parent_row is None:
                    _die(f"--depends-on {parent_id} does not exist on board {BOARD}")
                parent_title = parent_row["title"] or ""
                if "[EPIC]" in parent_title:
                    _die(
                        f"--depends-on {parent_id} targets an [EPIC] card "
                        f"({parent_title!r}). Epics stay `ready` for the whole phase "
                        f"and never reach `done`, so a child depends-on'd to one is "
                        f"wedged in `todo` forever (observed g-2026-05-28-5).\n"
                        f"  Use --epic {parent_id} instead — that tags membership "
                        f"via body trailer without gating promotion.\n"
                        f"  --depends-on is for real per-card prereqs (e.g. SUPPLY "
                        f"depends-on a SCOUT that registered the mark)."
                    )

    cmd: list[str] = [
        "hermes",
        "kanban",
        "--board",
        BOARD,
        "create",
        args.title,
        "--assignee",
        args.assignee,
    ]
    if body:
        cmd.extend(["--body", body])
    if args.priority is not None:
        cmd.extend(["--priority", str(args.priority)])
    if args.triage:
        cmd.append("--triage")
    for s in args.skill or []:
        cmd.extend(["--skill", s])
    if args.max_retries is not None:
        cmd.extend(["--max-retries", str(args.max_retries)])
    if args.idempotency_key:
        cmd.extend(["--idempotency-key", args.idempotency_key])
    # We always need JSON back to extract the task id and attach
    # depends-on edges atomically-ish.
    cmd.append("--json")

    proc = _run(cmd, timeout=30)
    if proc.returncode != 0:
        _die(f"create failed: {proc.stderr.strip() or proc.stdout.strip()}")
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        _die(f"create returned non-JSON: {proc.stdout[:200]}")
    tid = str(
        data.get("id")
        or data.get("task_id")
        or (data.get("task") or {}).get("id")
        or ""
    )
    if not tid or tid == "None":
        _die(f"could not parse task id from {proc.stdout[:200]}")

    # Attach depends-on edges via `hermes kanban link`. Order doesn't
    # matter; each is independent. If any link fails we report it but
    # don't roll back — the card is created, the operator can fix the
    # link by hand if needed.
    failed_links: list[tuple[str, str]] = []
    for parent in args.depends_on or []:
        link_cmd = ["hermes", "kanban", "--board", BOARD, "link", parent, tid]
        lp = _run(link_cmd, timeout=15)
        if lp.returncode != 0:
            failed_links.append((parent, lp.stderr.strip() or f"exit {lp.returncode}"))

    if args.json:
        print(
            json.dumps(
                {
                    "id": tid,
                    "title": args.title,
                    "assignee": args.assignee,
                    "epic": args.epic,
                    "depends_on": list(args.depends_on or []),
                    "depends_on_failed": [
                        {"parent": p, "error": e} for p, e in failed_links
                    ],
                }
            )
        )
    else:
        epic_note = f" epic={args.epic}" if args.epic else ""
        dep_note = (
            f" depends_on={','.join(args.depends_on)}" if args.depends_on else ""
        )
        print(f"{tid}  {args.title}  → {args.assignee}{epic_note}{dep_note}")
        for parent, err in failed_links:
            print(f"  ! depends-on {parent} FAILED: {err}", file=sys.stderr)

    return 1 if failed_links else 0


# ─── command: add-epic / add ────────────────────────────────────────────────


def cmd_add_epic(args: argparse.Namespace) -> int:
    """Create an epic card. Ensures the title starts with ``[EPIC]``."""
    title = args.title.strip()
    if "[EPIC]" not in title:
        title = f"[EPIC] {title}"
    cmd: list[str] = [
        "hermes", "kanban", "--board", BOARD, "create", title,
        "--assignee", args.assignee or "steward",
    ]
    if args.body:
        cmd.extend(["--body", args.body])
    if args.priority is not None:
        cmd.extend(["--priority", str(args.priority)])
    cmd.append("--json")
    proc = _run(cmd, timeout=30)
    if proc.returncode != 0:
        _die(f"add-epic failed: {proc.stderr.strip() or proc.stdout.strip()}")
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        _die(f"add-epic returned non-JSON: {proc.stdout[:200]}")
    tid = str(data.get("id") or data.get("task_id") or (data.get("task") or {}).get("id") or "")
    if args.json:
        print(json.dumps({"id": tid, "title": title}))
    else:
        print(f"{tid}  {title}")
    return 0


def cmd_add(args: argparse.Namespace) -> int:
    """Create a worker card under an epic.

    Action-oriented replacement for ``create``: ``--for`` is the epic
    (body trailer, no gate), ``--after`` is real prereqs (task_links).
    Size defaults to ``M`` when omitted, with a stderr note so Steward
    knows it's defaulted rather than chosen.
    """
    size = _validate_size(args.size)
    if size is None:
        size = DEFAULT_SIZE
        print(f"# (size defaulted to {DEFAULT_SIZE})", file=sys.stderr)
    loc_x, loc_y, loc_z = _parse_location(args.at)

    body = args.body or ""
    if args.epic_for:
        with _db() as conn:
            row = _fetch_task(conn, args.epic_for)
        if row is None:
            _die(f"--for {args.epic_for} does not exist on board {BOARD}")
        body = _attach_trailer(body, epic=args.epic_for)

    if args.after:
        with _db() as conn:
            for parent_id in args.after:
                p = _fetch_task(conn, parent_id)
                if p is None:
                    _die(f"--after {parent_id} does not exist on board {BOARD}")
                # Same wedge guard as cmd_create's --depends-on: refuse real
                # prereqs against an [EPIC] (epics stay `ready` forever; the
                # child would wedge in todo).
                if "[EPIC]" in (p["title"] or ""):
                    _die(
                        f"--after {parent_id} targets an [EPIC] card. "
                        f"Use --for {parent_id} for epic membership; "
                        f"--after is for per-card prereqs that actually reach done."
                    )

    # Phase 10 PR-R — dispatch-time card-body linter (same call as
    # cmd_create's). Reject malformed CONSTRUCT/MINE/TILL/SUPPLY/SURVEY
    # cards before they enter `ready`. --triage cards skip the check
    # because the spec is intentionally a stub at that stage.
    if not getattr(args, "allow_prose", False) and not args.triage:
        if str(REPO_ROOT) not in sys.path:
            sys.path.insert(0, str(REPO_ROOT))
        from scripts.lib.card_body_linter import lint_card_body
        lint = lint_card_body(kind=None, title=args.title, body=body)
        if not lint["ok"]:
            msg = "; ".join(lint["errors"])
            _die(
                f"card body lint failed: {msg}\n"
                f"  Pass --allow-prose if you intentionally want a prose-only "
                f"card (rare — usually means the body needs a literal mc verb "
                f"line). Or pass --triage to defer the spec to a specifier."
            )

    cmd: list[str] = [
        "hermes", "kanban", "--board", BOARD, "create", args.title,
        "--assignee", args.assignee,
    ]
    if body:
        cmd.extend(["--body", body])
    if args.priority is not None:
        cmd.extend(["--priority", str(args.priority)])
    for s in args.skill or []:
        cmd.extend(["--skill", s])
    if args.max_retries is not None:
        cmd.extend(["--max-retries", str(args.max_retries)])
    if args.idempotency_key:
        cmd.extend(["--idempotency-key", args.idempotency_key])
    if args.triage:
        cmd.append("--triage")
    cmd.append("--json")
    proc = _run(cmd, timeout=30)
    if proc.returncode != 0:
        _die(f"add failed: {proc.stderr.strip() or proc.stdout.strip()}")
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        _die(f"add returned non-JSON: {proc.stdout[:200]}")
    tid = str(data.get("id") or data.get("task_id") or (data.get("task") or {}).get("id") or "")
    if not tid:
        _die(f"could not parse task id from {proc.stdout[:200]}")

    # Apply real-prereq edges.
    failed_links: list[tuple[str, str]] = []
    for parent in args.after or []:
        lp = _run(["hermes", "kanban", "--board", BOARD, "link", parent, tid], timeout=15)
        if lp.returncode != 0:
            failed_links.append((parent, lp.stderr.strip() or f"exit {lp.returncode}"))

    # Write size + location directly (Hermes create doesn't know about them).
    with _db_rw() as conn:
        conn.execute(
            "UPDATE tasks SET size = ?, location_x = ?, location_y = ?, location_z = ? "
            "WHERE id = ?",
            (size, loc_x, loc_y, loc_z, tid),
        )

    if args.json:
        print(json.dumps({
            "id": tid, "title": args.title, "assignee": args.assignee,
            "epic": args.epic_for, "after": list(args.after or []),
            "size": size,
            "location": (
                {"x": loc_x, "y": loc_y, "z": loc_z}
                if loc_x is not None else None
            ),
            "after_failed": [{"parent": p, "error": e} for p, e in failed_links],
        }))
    else:
        bits = [f"size={size}"]
        if args.epic_for:
            bits.append(f"for={args.epic_for}")
        if args.after:
            bits.append(f"after={','.join(args.after)}")
        if loc_x is not None:
            bits.append(f"at={loc_x},{loc_y},{loc_z}")
        print(f"{tid}  {args.title}  → {args.assignee}  ({' '.join(bits)})")
        for parent, err in failed_links:
            print(f"  ! after {parent} FAILED: {err}", file=sys.stderr)
    return 1 if failed_links else 0


# ─── command: list ──────────────────────────────────────────────────────────


def cmd_list(args: argparse.Namespace) -> int:
    """List cards, with optional --epic filter (body-trailer scan)."""
    with _db() as conn:
        rows = _all_tasks(conn, args.status, args.assignee)
        if args.epic:
            rows = [r for r in rows if _epic_of(r["body"]) == args.epic]

    if not rows:
        suffix = []
        if args.status:
            suffix.append(f"status={args.status}")
        if args.assignee:
            suffix.append(f"assignee={args.assignee}")
        if args.epic:
            suffix.append(f"epic={args.epic}")
        print(f"# no cards match ({', '.join(suffix) or 'all'})")
        return 0

    print(f"# board={BOARD}  rows={len(rows)}")
    # Group by status, preserving a sensible order
    order = ["running", "ready", "todo", "blocked", "triage", "done", "archived"]
    rows.sort(
        key=lambda r: (
            order.index(r["status"]) if r["status"] in order else 99,
            -(r["priority"] or 0),
            r["id"],
        )
    )
    cur_status = None
    for r in rows:
        if r["status"] != cur_status:
            cur_status = r["status"]
            print(f"# ── {cur_status} ──")
        epic = _epic_of(r["body"])
        epic_tag = f" [epic={epic}]" if epic else ""
        lock = ""
        if r["claim_lock"] and r["claim_lock"].startswith("mutex_park:"):
            lock = " [parked]"
        elif r["claim_lock"] and r["claim_lock"].startswith("orch_continuous:"):
            lock = " [orch]"
        title = (r["title"] or "").strip()
        if len(title) > 60:
            title = title[:59] + "…"
        assignee = r["assignee"] or "—"
        print(
            f"  {r['id']}  {assignee:<10}  p{(r['priority'] or 0):>2}  {title}{epic_tag}{lock}"
        )
    return 0


# ─── command: show ──────────────────────────────────────────────────────────


def cmd_show(args: argparse.Namespace) -> int:
    """Show one card + its dependencies + epic membership."""
    with _db() as conn:
        row = _fetch_task(conn, args.task_id)
        if row is None:
            _die(f"no task {args.task_id} on board {BOARD}")
        parents = _fetch_parents(conn, args.task_id)
        children = _fetch_children(conn, args.task_id)
    visible, trailer = _split_body_trailer(row["body"] or "")
    if args.json:
        print(
            json.dumps(
                {
                    "id": row["id"],
                    "title": row["title"],
                    "status": row["status"],
                    "assignee": row["assignee"],
                    "priority": row["priority"],
                    "body": visible,
                    "trailer": trailer,
                    "depends_on": [dict(p) for p in parents],
                    "dependency_of": [dict(c) for c in children],
                },
                default=str,
            )
        )
        return 0

    print(f"{row['id']}  {row['title']}")
    print(f"  status:    {row['status']}")
    print(f"  assignee:  {row['assignee'] or '—'}")
    print(f"  priority:  {row['priority'] or 0}")
    if trailer.get("epic"):
        print(f"  epic:      {trailer['epic']}")
    if trailer.get("genesis_run"):
        print(f"  genesis:   {trailer['genesis_run']}")
    if row["claim_lock"]:
        print(f"  lock:      {row['claim_lock']}")

    if parents:
        print(f"  depends_on ({len(parents)}):")
        for p in parents:
            done = "✓" if p["status"] in ("done", "archived") else "◻"
            print(f"    {done} {p['id']}  [{p['status']}]  {p['title']}")
    if children:
        print(f"  dependency_of ({len(children)}):")
        for c in children:
            done = "✓" if c["status"] in ("done", "archived") else "◻"
            print(f"    {done} {c['id']}  [{c['status']}]  {c['title']}")

    if visible:
        print("  body:")
        for line in visible.splitlines()[:30]:
            print(f"    {line}")
        more = len(visible.splitlines()) - 30
        if more > 0:
            print(f"    … (+{more} more lines; `hermes kanban show {row['id']}` for full)")
    return 0


# ─── command: dependencies / depends-add / depends-remove ───────────────────


def cmd_dependencies(args: argparse.Namespace) -> int:
    """Print both directions of the dependency graph for one card.

    depends_on    = task_links where this card is the CHILD
                    (cards that must be done before this one promotes)
    dependency_of = task_links where this card is the PARENT
                    (cards that are waiting on this one)
    """
    with _db() as conn:
        row = _fetch_task(conn, args.task_id)
        if row is None:
            _die(f"no task {args.task_id}")
        parents = _fetch_parents(conn, args.task_id)
        children = _fetch_children(conn, args.task_id)

    if args.json:
        print(
            json.dumps(
                {
                    "task": {"id": row["id"], "title": row["title"], "status": row["status"]},
                    "depends_on": [dict(p) for p in parents],
                    "dependency_of": [dict(c) for c in children],
                }
            )
        )
        return 0

    print(f"{row['id']}  {row['title']}  [{row['status']}]")
    if not parents and not children:
        print("  (no dependencies)")
        return 0

    if parents:
        print("  depends_on:")
        for p in parents:
            done = "✓" if p["status"] in ("done", "archived") else "◻"
            print(f"    {done} {p['id']}  [{p['status']}]  {p['title']}")
    if children:
        print("  dependency_of:")
        for c in children:
            done = "✓" if c["status"] in ("done", "archived") else "◻"
            print(f"    {done} {c['id']}  [{c['status']}]  {c['title']}")
    return 0


def cmd_depends_add(args: argparse.Namespace) -> int:
    """Add a real prerequisite: <child> cannot promote until <parent> is done."""
    # `hermes kanban link <parent> <child>` — the verb order is parent-first.
    out = _hermes("link", args.parent, args.child, timeout=15)
    print(f"linked {args.child} depends-on {args.parent}")
    if out and not out.strip().startswith("("):
        # echo any framework message
        sys.stdout.write(out)
    return 0


def cmd_depends_remove(args: argparse.Namespace) -> int:
    out = _hermes("unlink", args.parent, args.child, timeout=15)
    print(f"unlinked {args.child} from {args.parent}")
    if out and not out.strip().startswith("("):
        sys.stdout.write(out)
    return 0


# ─── command: epic + epic-of + list-epics ───────────────────────────────────


def cmd_epic_of(args: argparse.Namespace) -> int:
    with _db() as conn:
        row = _fetch_task(conn, args.task_id)
    if row is None:
        _die(f"no task {args.task_id}")
    epic = _epic_of(row["body"])
    if args.json:
        print(json.dumps({"id": row["id"], "epic": epic}))
    elif epic:
        print(epic)
    else:
        print(f"# {args.task_id} has no epic tag")
        return 1
    return 0


def cmd_epic(args: argparse.Namespace) -> int:
    """Show one epic + all cards body-tagged as members of it."""
    with _db() as conn:
        row = _fetch_task(conn, args.epic_id)
        if row is None:
            _die(f"no task {args.epic_id}")
        children = _scan_epic_children(conn, args.epic_id)
        # Also include any real-dep children so the view is complete
        link_children = _fetch_children(conn, args.epic_id)

    if args.json:
        print(
            json.dumps(
                {
                    "id": row["id"],
                    "title": row["title"],
                    "status": row["status"],
                    "members": [dict(c) for c in children],
                    "dep_children": [dict(c) for c in link_children],
                },
                default=str,
            )
        )
        return 0

    print(f"{row['id']}  {row['title']}  [{row['status']}]")
    if children:
        print(f"  members (epic tag, {len(children)}):")
        for c in children:
            done = "✓" if c["status"] in ("done", "archived") else "◻"
            assignee = c["assignee"] or "—"
            print(f"    {done} {c['id']}  [{c['status']:<8}] {assignee:<10} {c['title']}")
    if link_children:
        # Filter out any that are already shown as epic members (some cards
        # may legitimately be both — depends-on AND epic-tagged — though we
        # discourage this).
        member_ids = {c["id"] for c in children}
        extras = [c for c in link_children if c["id"] not in member_ids]
        if extras:
            print(f"  dep-children (real prerequisite, {len(extras)}):")
            for c in extras:
                done = "✓" if c["status"] in ("done", "archived") else "◻"
                assignee = c["assignee"] or "—"
                print(
                    f"    {done} {c['id']}  [{c['status']:<8}] {assignee:<10} {c['title']}"
                )
    if not children and not link_children:
        print("  (no members or dep-children)")
    return 0


def cmd_list_epics(args: argparse.Namespace) -> int:
    """Show every card that has an [EPIC] title prefix or is the target of an
    epic-trailer tag from at least one other card. Useful for `kanban epic`
    discovery."""
    with _db() as conn:
        rows = list(
            conn.execute(
                "SELECT id, title, status, assignee, body FROM tasks "
                "WHERE title LIKE '%[EPIC]%' OR title LIKE '[EPIC]%' "
                "ORDER BY status, created_at"
            )
        )
    if args.json:
        out = []
        for r in rows:
            with _db() as conn:
                members = _scan_epic_children(conn, r["id"])
            out.append(
                {
                    "id": r["id"],
                    "title": r["title"],
                    "status": r["status"],
                    "assignee": r["assignee"],
                    "members": len(members),
                }
            )
        print(json.dumps(out))
        return 0
    if not rows:
        print("# no epics on board")
        return 0
    print(f"# board={BOARD}  epics={len(rows)}")
    for r in rows:
        with _db() as conn:
            members = _scan_epic_children(conn, r["id"])
        print(
            f"  {r['id']}  [{r['status']:<8}] {r['assignee'] or '—':<10}  members={len(members)}  {r['title']}"
        )
    return 0


# ─── command: complete / block / unblock / reassign / comment / archive ────


def cmd_complete(args: argparse.Namespace) -> int:
    # A12-lite (Phase 3 / item 3.2, 2026-06-02): caller-vs-assignee check.
    # Steward shouldn't close worker-assigned cards without the worker's
    # own kanban_complete — the postmortem showed her synthesizing summaries
    # for cards the worker never actually executed. Workers should close
    # their own cards; Steward orchestrates via comments instead.
    #
    # Trigger: HERMES_PROFILE=steward AND the task's assignee != steward.
    # Override: KANBAN_ALLOW_STEWARD_COMPLETE=1 for explicit operator rescue
    # (e.g., closing a worker-stuck card after RESCUE_DISPATCH).
    caller = (os.environ.get("HERMES_PROFILE") or "").strip().lower()
    if caller == "steward" and os.environ.get("KANBAN_ALLOW_STEWARD_COMPLETE") != "1":
        try:
            conn = _db()
            row = conn.execute(
                "SELECT assignee FROM tasks WHERE id = ?", (args.task_id,)
            ).fetchone()
            assignee = (row[0] if row else None) or ""
            if assignee.strip().lower() != "steward":
                sys.stderr.write(
                    f"refused: caller=steward but assignee={assignee or '(none)'} for {args.task_id}.\n"
                    "Workers close their own cards. Orchestrator path: scripts/kanban comment <id> '<update>'.\n"
                    "If you must override (e.g. RESCUE_DISPATCH closeout), re-run with KANBAN_ALLOW_STEWARD_COMPLETE=1.\n"
                )
                return 2
        except sqlite3.Error:
            # If the DB read fails, fall through to the underlying hermes
            # call; the worker-evidence audit isn't worth blocking on a
            # transient DB hiccup (default-allow keeps the facade usable).
            pass
    cmd_args = ["complete", args.task_id]
    if args.result:
        cmd_args.extend(["--result", args.result])
    out = _hermes(*cmd_args, timeout=20)
    if out and out.strip():
        sys.stdout.write(out)
    print(f"# completed {args.task_id}")
    return 0


def cmd_block(args: argparse.Namespace) -> int:
    cmd_args = ["block", args.task_id]
    if args.reason:
        cmd_args.append(args.reason)
    out = _hermes(*cmd_args, timeout=15)
    if out and out.strip():
        sys.stdout.write(out)
    print(f"# blocked {args.task_id}")
    return 0


def cmd_unblock(args: argparse.Namespace) -> int:
    out = _hermes("unblock", args.task_id, timeout=15)
    if out and out.strip():
        sys.stdout.write(out)
    print(f"# unblocked {args.task_id}")
    return 0


def cmd_reassign(args: argparse.Namespace) -> int:
    out = _hermes("reassign", args.task_id, args.assignee, timeout=15)
    if out and out.strip():
        sys.stdout.write(out)
    print(f"# reassigned {args.task_id} → {args.assignee}")
    return 0


def cmd_comment(args: argparse.Namespace) -> int:
    out = _hermes("comment", args.task_id, args.text, timeout=15)
    if out and out.strip():
        sys.stdout.write(out)
    print(f"# commented on {args.task_id}")
    return 0


def cmd_archive(args: argparse.Namespace) -> int:
    out = _hermes("archive", *args.task_ids, timeout=15)
    if out and out.strip():
        sys.stdout.write(out)
    print(f"# archived {', '.join(args.task_ids)}")
    return 0


# ─── consolidated read views (board / card) ────────────────────────────────


def _format_age(seconds: int) -> str:
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86_400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86_400}d"


def _latest_block_payload(conn: sqlite3.Connection, task_id: str) -> Optional[str]:
    """Return the most recent kanban_block event's reason text for a card."""
    row = conn.execute(
        "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'blocked' "
        "ORDER BY created_at DESC LIMIT 1",
        (task_id,),
    ).fetchone()
    if not row or not row["payload"]:
        return None
    try:
        data = json.loads(row["payload"])
    except json.JSONDecodeError:
        return None
    if isinstance(data, dict):
        return data.get("reason") or data.get("message")
    return None


def _latest_card_note(conn: sqlite3.Connection, task_id: str) -> Optional[str]:
    """Return a short trailing chat-like marker for the in-flight view."""
    row = conn.execute(
        "SELECT body FROM task_comments WHERE task_id = ? "
        "ORDER BY created_at DESC LIMIT 1",
        (task_id,),
    ).fetchone()
    if not row:
        return None
    line = (row["body"] or "").splitlines()[0] if row["body"] else ""
    return line.strip() or None


def _epic_member_counts(conn: sqlite3.Connection, epic_id: str) -> dict:
    """Count members of an epic by status. Members = body-trailer hits ∪
    real task_links children, **excluding next-phase epic-chain links**
    (e.g. P2 is parent-linked to P1 but is its own epic, not a member of
    P1). Used by the EPICS OPEN section."""
    trailer = conn.execute(
        "SELECT id, title, status FROM tasks WHERE body LIKE ? ",
        (f"%epic: {epic_id}%",),
    ).fetchall()
    links = conn.execute(
        "SELECT c.id, c.title, c.status FROM task_links l "
        "JOIN tasks c ON c.id = l.child_id WHERE l.parent_id = ?",
        (epic_id,),
    ).fetchall()
    seen: dict[str, str] = {}
    for r in (*trailer, *links):
        # Skip child cards that are themselves epics — those are the
        # phase-chain neighbors (P2 depends on P1, etc.), not real
        # worker children. Without this, P1's `0/N done` over-counts
        # by the chain depth and Steward sees N+1 instead of N.
        if "[EPIC]" in (r["title"] or ""):
            continue
        seen[r["id"]] = r["status"]
    out = {"total": len(seen), "done": 0, "running": 0, "ready": 0,
           "blocked": 0, "todo": 0, "triage": 0, "needs_review": 0}
    for tid, status in seen.items():
        if status == "done" or status == "archived":
            out["done"] += 1
        elif status == "running":
            out["running"] += 1
        elif status == "ready":
            out["ready"] += 1
        elif status == "blocked":
            # Cards blocked with an [!ESCALATED] event count under needs_review.
            reason = _latest_block_payload(conn, tid) or ""
            if reason.startswith("[!ESCALATED]"):
                out["needs_review"] += 1
            else:
                out["blocked"] += 1
        elif status == "todo":
            out["todo"] += 1
        elif status == "triage":
            out["triage"] += 1
    return out


def cmd_board(args: argparse.Namespace) -> int:
    """One-screen orient view for Steward.

    Replaces the today-fragmented `list` + `fleet-status.py` +
    `base-inventory.py` pass with a single render that fits on a single
    terminal screen. Sections: IN-FLIGHT, READY, NEEDS REVIEW, BLOCKED,
    EPICS OPEN, RECENT.
    """
    import time as _time
    now = int(_time.time())
    cutoff_recent = now - 15 * 60

    with _db() as conn:
        in_flight = list(conn.execute(
            "SELECT id, title, assignee, status, size, started_at "
            "FROM tasks WHERE status = 'running' ORDER BY started_at"
        ))
        # READY excludes [EPIC] cards — epics stay `ready` for a whole
        # phase as orchestrator-continuous trackers. They get their own
        # EPICS OPEN section below; double-listing them here would
        # crowd the lane Steward actually dispatches from.
        ready = list(conn.execute(
            "SELECT id, title, assignee, size, priority "
            "FROM tasks WHERE status = 'ready' AND title NOT LIKE '%[EPIC]%' "
            "ORDER BY priority DESC, created_at"
        ))
        blocked_rows = list(conn.execute(
            "SELECT id, title, assignee, size FROM tasks WHERE status = 'blocked' "
            "ORDER BY created_at"
        ))
        epics = list(conn.execute(
            "SELECT id, title, status FROM tasks "
            "WHERE title LIKE '%[EPIC]%' AND status NOT IN ('done', 'archived') "
            "ORDER BY priority DESC, created_at"
        ))
        recent = list(conn.execute(
            "SELECT e.task_id, e.kind, e.payload, e.created_at, t.title, t.assignee "
            "FROM task_events e LEFT JOIN tasks t ON t.id = e.task_id "
            "WHERE e.created_at >= ? "
            "ORDER BY e.created_at DESC LIMIT 12",
            (cutoff_recent,),
        ))
        # Split blocked into needs-review vs vanilla blocked.
        needs_review = []
        plain_blocked = []
        for r in blocked_rows:
            reason = _latest_block_payload(conn, r["id"]) or ""
            if reason.startswith("[!ESCALATED]"):
                needs_review.append((r, reason))
            else:
                plain_blocked.append((r, reason))
        # Prereq status for ready cards.
        ready_with_prereqs = []
        for r in ready:
            undone = conn.execute(
                "SELECT p.id, p.status FROM task_links l JOIN tasks p ON p.id = l.parent_id "
                "WHERE l.child_id = ? AND p.status NOT IN ('done', 'archived')",
                (r["id"],),
            ).fetchall()
            ready_with_prereqs.append((r, undone))
        # Latest comment for in-flight cards.
        in_flight_with_notes = [(r, _latest_card_note(conn, r["id"])) for r in in_flight]
        # Epic counts.
        epic_counts = [(e, _epic_member_counts(conn, e["id"])) for e in epics]

    if args.json:
        print(json.dumps({
            "board": BOARD,
            "in_flight": [
                {"id": r["id"], "title": r["title"], "assignee": r["assignee"],
                 "size": r["size"], "runtime_s": now - (r["started_at"] or now),
                 "last": note}
                for r, note in in_flight_with_notes
            ],
            "ready": [
                {"id": r["id"], "title": r["title"], "assignee": r["assignee"],
                 "size": r["size"], "priority": r["priority"],
                 "prereqs_undone": [u["id"] for u in undone]}
                for r, undone in ready_with_prereqs
            ],
            "needs_review": [
                {"id": r["id"], "title": r["title"], "assignee": r["assignee"],
                 "reason": reason}
                for r, reason in needs_review
            ],
            "blocked": [
                {"id": r["id"], "title": r["title"], "assignee": r["assignee"],
                 "reason": reason}
                for r, reason in plain_blocked
            ],
            "epics_open": [
                {"id": e["id"], "title": e["title"], **counts}
                for e, counts in epic_counts
            ],
            "recent": [
                {"task_id": r["task_id"], "kind": r["kind"], "title": r["title"],
                 "assignee": r["assignee"], "ts": r["created_at"]}
                for r in recent
            ],
        }, default=str))
        return 0

    import datetime as _dt
    stamp = _dt.datetime.fromtimestamp(now).strftime("%Y-%m-%d %H:%M")
    print(f"{BOARD} ─ {stamp}")
    print("─" * 60)

    print(f"IN-FLIGHT ({len(in_flight_with_notes)})")
    for r, note in in_flight_with_notes:
        runtime = _format_age(now - (r["started_at"] or now))
        size = r["size"] or "—"
        title = (r["title"] or "")[:50]
        tail = f" · last: \"{note[:50]}\"" if note else ""
        print(f"  {r['assignee'] or '—':<10} {r['id']}  size {size:<3} runtime {runtime:<5} {title}{tail}")
    if not in_flight_with_notes:
        print("  (none)")

    print()
    print(f"READY ({len(ready_with_prereqs)})")
    for r, undone in ready_with_prereqs[:6]:
        size = r["size"] or "—"
        title = (r["title"] or "")[:46]
        if undone:
            mark = f"prereqs ⏳ waits {undone[0]['id']}"
        else:
            mark = "prereqs ✓"
        print(f"  {r['id']}  {r['assignee'] or '—':<10} size {size:<3} {title:<46} {mark}")
    if len(ready_with_prereqs) > 6:
        print(f"  … (+{len(ready_with_prereqs) - 6} more)")
    if not ready_with_prereqs:
        print("  (none)")

    print()
    print(f"NEEDS REVIEW ({len(needs_review)})")
    for r, reason in needs_review:
        # Strip the [!ESCALATED] prefix for display; the section header
        # already conveys it.
        short = reason.removeprefix("[!ESCALATED]").strip().lstrip(":")[:80]
        print(f"  {r['id']}  {r['assignee'] or '—':<10} {short}")
    if not needs_review:
        print("  (none)")

    if plain_blocked:
        print()
        print(f"BLOCKED ({len(plain_blocked)})")
        for r, reason in plain_blocked:
            short = (reason or "")[:80]
            print(f"  {r['id']}  {r['assignee'] or '—':<10} {short}")

    print()
    print(f"EPICS OPEN ({len(epic_counts)})")
    for e, c in epic_counts:
        title = (e["title"] or "")[:50]
        bits = [f"{c['done']}/{c['total']} done"]
        if c["running"]:
            bits.append(f"{c['running']} in-flight")
        if c["ready"]:
            bits.append(f"{c['ready']} ready")
        if c["needs_review"]:
            bits.append(f"{c['needs_review']} needs-review")
        print(f"  {e['id']}  {title}  {' · '.join(bits)}")
    if not epic_counts:
        print("  (none)")

    print()
    print(f"RECENT (last 15m, {len(recent)})")
    for r in recent:
        when = _dt.datetime.fromtimestamp(r["created_at"]).strftime("%H:%M")
        action_map = {
            "created":       "created",
            "promoted":      "promoted",
            "blocked":       "blocked",
            "unblocked":     "unblocked",
            "completed":     "closed",
            "comment_added": "comment",
            "reassigned":    "reassign",
            "reprioritized": "repri",
            "edited":        "edited",
        }
        action = action_map.get(r["kind"], r["kind"])
        title = (r["title"] or "")[:36]
        print(f"  {when}  {r['assignee'] or '—':<10} {action:<8} {r['task_id']}  {title}")
    if not recent:
        print("  (none in window)")

    return 0


def cmd_card(args: argparse.Namespace) -> int:
    """Detailed card view with location, size, full comments, and recent
    events. Like ``show`` but tuned for the new schema."""
    with _db() as conn:
        row = conn.execute(
            "SELECT id, title, body, assignee, status, priority, "
            "       size, location_x, location_y, location_z, "
            "       created_at, started_at, completed_at, claim_lock "
            "FROM tasks WHERE id = ?",
            (args.task_id,),
        ).fetchone()
        if row is None:
            _die(f"no task {args.task_id}")
        parents = _fetch_parents(conn, args.task_id)
        children = _fetch_children(conn, args.task_id)
        comments = list(conn.execute(
            "SELECT author, body, created_at FROM task_comments WHERE task_id = ? "
            "ORDER BY created_at",
            (args.task_id,),
        ))
        events = list(conn.execute(
            "SELECT kind, payload, created_at FROM task_events WHERE task_id = ? "
            "ORDER BY created_at DESC LIMIT 8",
            (args.task_id,),
        ))
    visible, trailer = _split_body_trailer(row["body"] or "")

    if args.json:
        loc = None
        if row["location_x"] is not None:
            loc = {"x": row["location_x"], "y": row["location_y"], "z": row["location_z"]}
        print(json.dumps({
            "id": row["id"], "title": row["title"], "status": row["status"],
            "assignee": row["assignee"], "priority": row["priority"],
            "size": row["size"], "location": loc,
            "body": visible, "trailer": trailer,
            "depends_on": [dict(p) for p in parents],
            "dependency_of": [dict(c) for c in children],
            "comments": [
                {"author": c["author"], "body": c["body"], "created_at": c["created_at"]}
                for c in comments
            ],
            "events": [
                {"kind": e["kind"], "payload": e["payload"], "created_at": e["created_at"]}
                for e in events
            ],
        }, default=str))
        return 0

    print(f"{row['id']}  ─ {row['status']} ─ {row['assignee'] or '—'}")
    print(f"  {row['title']}")
    size = row["size"] or "—"
    loc_s = (f"{row['location_x']},{row['location_y']},{row['location_z']}"
             if row["location_x"] is not None else "—")
    print(f"  size: {size}  ·  location: {loc_s}  ·  priority: {row['priority'] or 0}")
    if trailer.get("epic"):
        print(f"  epic: {trailer['epic']}")
    if row["claim_lock"]:
        print(f"  lock: {row['claim_lock']}")
    if visible:
        print("  body:")
        for line in visible.splitlines()[:30]:
            print(f"    {line}")
    if parents:
        print(f"  depends on ({len(parents)}):")
        for p in parents:
            tick = "✓" if p["status"] in ("done", "archived") else "◻"
            print(f"    {tick} {p['id']}  [{p['status']}]  {p['title']}")
    if children:
        print(f"  blocks ({len(children)}):")
        for c in children:
            tick = "✓" if c["status"] in ("done", "archived") else "◻"
            print(f"    {tick} {c['id']}  [{c['status']}]  {c['title']}")
    if comments:
        print(f"  comments ({len(comments)}):")
        import datetime as _dt
        for c in comments:
            when = _dt.datetime.fromtimestamp(c["created_at"]).strftime("%m-%d %H:%M")
            first = (c["body"] or "").splitlines()[0] if c["body"] else ""
            if len(first) > 120:
                first = first[:119] + "…"
            print(f"    [{when} {c['author']}] {first}")
    if events:
        print(f"  recent events ({len(events)}):")
        import datetime as _dt2
        for e in events:
            when = _dt2.datetime.fromtimestamp(e["created_at"]).strftime("%m-%d %H:%M")
            print(f"    [{when}] {e['kind']}")
    return 0


# ─── command: promote / resolve / set-priority / set-after / unset-after / edit / assign ─


def cmd_promote(args: argparse.Namespace) -> int:
    """Manual override: force a card from todo → ready.

    Used when Steward judges a card unblocked even though the dep-gate
    would still keep it in todo (e.g. parent is an [EPIC] orchestrator
    card that won't reach done for the whole phase). Writes a
    ``promoted`` event so the dashboard and watchers see the transition.
    """
    with _db_rw() as conn:
        row = conn.execute(
            "SELECT id, status, title FROM tasks WHERE id = ?",
            (args.task_id,),
        ).fetchone()
        if row is None:
            _die(f"no task {args.task_id}")
        if row["status"] not in ("todo", "triage"):
            _die(f"promote: {args.task_id} is {row['status']}, can only promote from todo/triage")
        # Soft warning when parents aren't all done — Steward's call to override.
        undone_parents = conn.execute(
            """
            SELECT p.id, p.status FROM task_links l
              JOIN tasks p ON p.id = l.parent_id
             WHERE l.child_id = ? AND p.status NOT IN ('done', 'archived')
            """,
            (args.task_id,),
        ).fetchall()
        if undone_parents and not args.force:
            ids = ", ".join(r["id"] for r in undone_parents)
            _die(
                f"promote: {args.task_id} has {len(undone_parents)} undone parents ({ids}). "
                f"Re-run with --force to override the dep-gate."
            )
        conn.execute("BEGIN IMMEDIATE")
        try:
            conn.execute(
                "UPDATE tasks SET status = 'ready' WHERE id = ? AND status IN ('todo', 'triage')",
                (args.task_id,),
            )
            _write_event(conn, args.task_id, "promoted", {"forced": bool(undone_parents)})
        except Exception:
            conn.execute("ROLLBACK")
            raise
        conn.execute("COMMIT")
    note = " (forced)" if undone_parents else ""
    print(f"# promoted {args.task_id} → ready{note}")
    return 0


def cmd_retry(args: argparse.Namespace) -> int:
    """Reset a card's failure counter and re-queue it for the dispatcher.

    Sanctioned path for "the dispatcher gave up on this card but the
    failure was a process issue, not a card-logic issue — reset and
    re-dispatch". Without this verb the only path was a raw SQL UPDATE
    against tasks.consecutive_failures (observed g-2026-05-29 Steward
    after Flint crashed on t_6fcbec8b), which the sandbox now refuses.

    Resets ``consecutive_failures`` to 0 and lifts ``status`` back to
    ``ready`` when the card is in a terminal-failure state. Writes a
    ``retried`` task_event so the dashboard and watchers see the
    transition; the optional ``--reason`` is captured in the payload.
    """
    with _db_rw() as conn:
        row = conn.execute(
            "SELECT id, status, consecutive_failures, last_failure_error "
            "FROM tasks WHERE id = ?",
            (args.task_id,),
        ).fetchone()
        if row is None:
            _die(f"no task {args.task_id}")
        old_failures = row["consecutive_failures"] or 0
        old_status = row["status"]
        # Only reset when there's actually something to reset. Catches
        # accidental retries on a healthy card; explicit `--force` overrides.
        if old_failures == 0 and old_status not in ("blocked",) and not args.force:
            _die(
                f"retry: {args.task_id} has 0 failures and status={old_status} — "
                f"nothing to reset. Re-run with --force to retry anyway."
            )
        new_status = "ready" if old_status in ("blocked", "todo", "triage") else old_status
        conn.execute("BEGIN IMMEDIATE")
        try:
            conn.execute(
                "UPDATE tasks SET consecutive_failures = 0, "
                "last_failure_error = NULL, status = ? WHERE id = ?",
                (new_status, args.task_id),
            )
            _write_event(conn, args.task_id, "retried",
                         {"from_failures": old_failures,
                          "from_status": old_status,
                          "to_status": new_status,
                          "reason": args.reason})
        except Exception:
            conn.execute("ROLLBACK")
            raise
        conn.execute("COMMIT")
    note = f": {args.reason}" if args.reason else ""
    print(f"# retried {args.task_id}: failures {old_failures}→0, "
          f"status {old_status}→{new_status}{note}")
    return 0


def cmd_resolve(args: argparse.Namespace) -> int:
    """Clear an escalation: unblock + record a [RESOLVED] comment.

    Mirror of ``wb escalate`` from the worker side. ``wb escalate
    "<reason>"`` records a ``kanban_block`` with ``[!ESCALATED] …`` and
    the dashboard surfaces it; ``kanban resolve <id> "<note>"`` reverses
    the block and leaves an audit trail in comments. No new event kind
    — keeps the schema flat.
    """
    note = args.note or "resolved by steward"
    _hermes("unblock", args.task_id, timeout=15)
    _hermes("comment", args.task_id, f"[RESOLVED] {note}", timeout=15)
    print(f"# resolved {args.task_id}: {note}")
    return 0


def cmd_set_priority(args: argparse.Namespace) -> int:
    with _db_rw() as conn:
        row = conn.execute(
            "SELECT id, priority FROM tasks WHERE id = ?", (args.task_id,)
        ).fetchone()
        if row is None:
            _die(f"no task {args.task_id}")
        old = row["priority"] or 0
        conn.execute("BEGIN IMMEDIATE")
        try:
            conn.execute(
                "UPDATE tasks SET priority = ? WHERE id = ?", (args.priority, args.task_id)
            )
            _write_event(conn, args.task_id, "reprioritized",
                         {"from": old, "to": args.priority})
        except Exception:
            conn.execute("ROLLBACK")
            raise
        conn.execute("COMMIT")
    print(f"# set-priority {args.task_id}: {old} → {args.priority}")
    return 0


def cmd_set_after(args: argparse.Namespace) -> int:
    """Add a real prereq edge: <child> cannot start until <parent> is done."""
    _hermes("link", args.parent, args.child, timeout=15)
    print(f"# set-after {args.child} ← {args.parent}")
    return 0


def cmd_unset_after(args: argparse.Namespace) -> int:
    _hermes("unlink", args.parent, args.child, timeout=15)
    print(f"# unset-after {args.child} ← {args.parent}")
    return 0


def cmd_edit_v2(args: argparse.Namespace) -> int:
    """Edit in-flight card fields (title / body / size / location / priority).

    Hermes' upstream ``kanban edit`` only backfills result/summary on
    completed tasks. We need to touch live cards, so this writes
    directly. Refuses to operate on archived/done cards — those go
    through Hermes' ``edit`` instead.
    """
    sets: list[str] = []
    params: list = []
    if args.title is not None:
        sets.append("title = ?")
        params.append(args.title)
    if args.body is not None:
        sets.append("body = ?")
        params.append(args.body)
    if args.size is not None:
        size = _validate_size(args.size)
        sets.append("size = ?")
        params.append(size)
    if args.at is not None:
        x, y, z = _parse_location(args.at)
        sets.extend(["location_x = ?", "location_y = ?", "location_z = ?"])
        params.extend([x, y, z])
    if args.priority is not None:
        sets.append("priority = ?")
        params.append(args.priority)
    if not sets:
        _die("edit: nothing to change (pass at least one of --title/--body/--size/--at/--priority)")

    with _db_rw() as conn:
        row = conn.execute(
            "SELECT id, status FROM tasks WHERE id = ?", (args.task_id,)
        ).fetchone()
        if row is None:
            _die(f"no task {args.task_id}")
        if row["status"] in ("done", "archived"):
            _die(f"edit: {args.task_id} is {row['status']} — use `hermes kanban edit` "
                 "for backfilling result/summary on completed tasks")
        params.append(args.task_id)
        conn.execute("BEGIN IMMEDIATE")
        try:
            conn.execute(f"UPDATE tasks SET {', '.join(sets)} WHERE id = ?", params)
            _write_event(conn, args.task_id, "edited",
                         {"fields": [s.split(" = ")[0] for s in sets]})
        except Exception:
            conn.execute("ROLLBACK")
            raise
        conn.execute("COMMIT")
    print(f"# edited {args.task_id}: {', '.join(s.split(' = ')[0] for s in sets)}")
    return 0


def cmd_assign(args: argparse.Namespace) -> int:
    out = _hermes("assign", args.task_id, args.assignee, timeout=15)
    if out and out.strip():
        sys.stdout.write(out)
    print(f"# assigned {args.task_id} → {args.assignee}")
    return 0


# ─── dispatch ───────────────────────────────────────────────────────────────


def _build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="kanban",
        description=__doc__.split("\n\n", 1)[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Environment:\n"
            "  HERMES_KANBAN_BOARD  default: landfolk-ops\n"
            "  HERMES_KANBAN_DB     default: ~/.hermes/kanban/boards/<board>/kanban.db\n"
        ),
    )
    sub = ap.add_subparsers(dest="cmd", required=True)

    # create (legacy alias — kept working; prefer `add`/`add-epic`)
    p = sub.add_parser("create", help="(legacy) Create a card; prefer `add` / `add-epic`")
    p.add_argument("title", help="Card title (often starts with [SCOUT]/[CONSTRUCT]/[SUPPLY]/[EPIC]…)")
    p.add_argument("--assignee", required=True)
    p.add_argument("--epic", help="Epic id this card belongs to (body trailer, no link)")
    p.add_argument(
        "--depends-on",
        action="append",
        default=[],
        metavar="ID",
        help="Real prerequisite — repeatable; cannot promote until each is done",
    )
    p.add_argument("--body", default="")
    p.add_argument("--priority", type=int)
    p.add_argument("--skill", action="append", default=[])
    p.add_argument("--triage", action="store_true")
    p.add_argument("--max-retries", type=int)
    p.add_argument("--idempotency-key")
    p.add_argument("--allow-prose", action="store_true",
                   help="Skip Phase 10 PR-R card-body lint. Rare — usually means the body should have a literal mc verb line.")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_create)

    # add-epic
    p = sub.add_parser("add-epic", help="Create an epic card (Steward's tracking unit for a phase)")
    p.add_argument("title")
    p.add_argument("--body", default="")
    p.add_argument("--priority", type=int)
    p.add_argument("--assignee", default="steward",
                   help="Profile that owns the epic (default: steward)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_add_epic)

    # add (action-oriented replacement for create)
    p = sub.add_parser("add",
                       help="Create a worker card. Use --for for epic membership, --after for real prereqs.")
    p.add_argument("title")
    p.add_argument("--assignee", required=True)
    p.add_argument("--for", dest="epic_for",
                   help="Epic id this card belongs to (body trailer, no dep gate)")
    p.add_argument("--after", action="append", default=[], metavar="ID",
                   help="Real prerequisite — repeatable; cannot start until each is done")
    p.add_argument("--body", default="")
    p.add_argument("--size", help=f"T-shirt estimate: {'/'.join(VALID_SIZES)} (default M)")
    p.add_argument("--at", metavar="X,Y,Z",
                   help="Location where the work happens (integer coords)")
    p.add_argument("--priority", type=int)
    p.add_argument("--skill", action="append", default=[])
    p.add_argument("--max-retries", type=int)
    p.add_argument("--idempotency-key")
    p.add_argument("--triage", action="store_true",
                   help="Park in triage — a specifier fleshes out the spec and promotes to todo")
    p.add_argument("--allow-prose", action="store_true",
                   help="Skip Phase 10 PR-R card-body lint. Rare — usually means the body should have a literal mc verb line.")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_add)

    # lint (Phase 10 PR-R — standalone hook for ad-hoc validation)
    p = sub.add_parser("lint",
                       help="Lint a card body without writing to the board (Phase 10 PR-R).")
    p.add_argument("--title", default="", help="Card title (used to infer [KIND] if --kind absent)")
    p.add_argument("--kind", default=None, help="Explicit kind override (CONSTRUCT, SUPPLY, etc.)")
    p.add_argument("--body", default="", help="Card body text to validate")
    p.add_argument("--body-file", type=Path, default=None, help="Read body from a file instead of --body")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_lint)

    # list
    p = sub.add_parser("list", help="List cards (optionally filtered)")
    p.add_argument("--status", help="comma-separated statuses; default = all")
    p.add_argument("--assignee")
    p.add_argument("--epic", help="Filter by epic membership (body trailer)")
    p.set_defaults(func=cmd_list)

    # show
    p = sub.add_parser("show", help="Show one card + its dependencies + epic")
    p.add_argument("task_id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_show)

    # dependencies + depends-add + depends-remove
    p = sub.add_parser("dependencies", help="List both directions of the dep graph for a card")
    p.add_argument("task_id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_dependencies)

    p = sub.add_parser("depends-add", help="<child> cannot start until <parent> is done")
    p.add_argument("child")
    p.add_argument("parent")
    p.set_defaults(func=cmd_depends_add)

    p = sub.add_parser("depends-remove", help="Remove a prerequisite edge")
    p.add_argument("child")
    p.add_argument("parent")
    p.set_defaults(func=cmd_depends_remove)

    # epic / epic-of / list-epics
    p = sub.add_parser("epic", help="Show an epic + every card body-tagged to it")
    p.add_argument("epic_id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_epic)

    p = sub.add_parser("epic-of", help="Print the epic id this card belongs to (if any)")
    p.add_argument("task_id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_epic_of)

    p = sub.add_parser("list-epics", help="Every card with an [EPIC] title prefix")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list_epics)

    # status verbs
    p = sub.add_parser("complete", help="Mark a card done")
    p.add_argument("task_id")
    p.add_argument("--result")
    p.set_defaults(func=cmd_complete)

    p = sub.add_parser("block", help="Mark a card blocked")
    p.add_argument("task_id")
    p.add_argument("reason", nargs="?")
    p.set_defaults(func=cmd_block)

    p = sub.add_parser("unblock", help="Return a blocked card to ready")
    p.add_argument("task_id")
    p.set_defaults(func=cmd_unblock)

    p = sub.add_parser("reassign", help="Reassign a card to a different profile")
    p.add_argument("task_id")
    p.add_argument("assignee")
    p.set_defaults(func=cmd_reassign)

    p = sub.add_parser("assign", help="Assign a card to a profile (upstream `hermes kanban assign`)")
    p.add_argument("task_id")
    p.add_argument("assignee")
    p.set_defaults(func=cmd_assign)

    p = sub.add_parser("comment", help="Append a comment to a card")
    p.add_argument("task_id")
    p.add_argument("text")
    p.set_defaults(func=cmd_comment)

    p = sub.add_parser("archive", help="Archive one or more cards")
    p.add_argument("task_ids", nargs="+")
    p.set_defaults(func=cmd_archive)

    # new action-oriented transitions
    p = sub.add_parser("promote",
                       help="Force a card from todo/triage → ready (override dep-gate with --force)")
    p.add_argument("task_id")
    p.add_argument("--force", action="store_true",
                   help="Promote even when parents aren't all done")
    p.set_defaults(func=cmd_promote)

    p = sub.add_parser("resolve",
                       help="Clear an escalation: unblock + record a [RESOLVED] comment")
    p.add_argument("task_id")
    p.add_argument("note", nargs="?")
    p.set_defaults(func=cmd_resolve)

    p = sub.add_parser("retry",
                       help="Reset failures + re-queue a card the dispatcher gave up on")
    p.add_argument("task_id")
    p.add_argument("--reason",
                   help="Short note recorded on the `retried` event")
    p.add_argument("--force", action="store_true",
                   help="Retry even when the card has 0 failures already")
    p.set_defaults(func=cmd_retry)

    p = sub.add_parser("set-priority", help="Change a card's priority")
    p.add_argument("task_id")
    p.add_argument("priority", type=int)
    p.set_defaults(func=cmd_set_priority)

    p = sub.add_parser("set-after",
                       help="Add a real prereq edge: <child> waits on <parent>")
    p.add_argument("child")
    p.add_argument("parent")
    p.set_defaults(func=cmd_set_after)

    p = sub.add_parser("unset-after", help="Remove a prereq edge")
    p.add_argument("child")
    p.add_argument("parent")
    p.set_defaults(func=cmd_unset_after)

    p = sub.add_parser("edit",
                       help="Edit a live card's title/body/size/location/priority")
    p.add_argument("task_id")
    p.add_argument("--title")
    p.add_argument("--body")
    p.add_argument("--size", help=f"T-shirt estimate: {'/'.join(VALID_SIZES)}")
    p.add_argument("--at", metavar="X,Y,Z", help="Location coords")
    p.add_argument("--priority", type=int)
    p.set_defaults(func=cmd_edit_v2)

    # consolidated read views
    p = sub.add_parser("board",
                       help="One-screen orient view: in-flight + ready + needs-review + epics + recent")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_board)

    p = sub.add_parser("card",
                       help="Detailed card view with location, size, comments, and recent events")
    p.add_argument("task_id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_card)

    return ap


def main(argv: Optional[list[str]] = None) -> int:
    if not shutil.which("hermes"):
        _die("`hermes` not on PATH — install Hermes Agent first")
    ap = _build_parser()
    args = ap.parse_args(argv)
    return args.func(args) or 0


if __name__ == "__main__":
    sys.exit(main())
