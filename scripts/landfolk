#!/usr/bin/env bash
# landfolk — single CLI for the Landfolk sub-project of HermesCraft.
#
# One verb set, one sticky roster, one state directory, one mental model:
#
#   PLAYERS  flint, mason, gatherer, barley, steward   (data/agent-models.json)
#   MODES    auto         — pick per role (default for new players)
#                          orchestrator → continuous, anything else → kanban.
#            kanban       — bot + connect-only watchdog, NO Hermes agent.
#                          Kanban gateway workers drive the bot per card.
#            continuous   — bot + full watchdog + always-on Hermes agent loop.
#   DAEMONS  listener, chat-wake (default on); supervisor, pauser (opt-in via start flags)
#   GATEWAY  hermes gateway                        (managed by start/stop by
#                                                   default; --no-gateway to
#                                                   leave alone, --keep-gateway
#                                                   on stop, --restart-gateway
#                                                   on start to force replace)
#
# Roster is the DESIRED STATE. `enable`/`disable` modify it (sticky across
# stop/start). `stop` does NOT wipe the roster — use `--clear-roster` for
# that. `start` brings up whatever's in the roster (or PLAYERS_DEFAULT if
# the roster is empty, recording it as the new sticky default).
#
# Usage:
#   scripts/landfolk start    [--players a,b,c] [--mode auto|kanban|continuous]
#                             [--continuous p,q] [--without daemons|listener|supervisor|pauser|chat-wake|gateway]
#                             [--no-gateway] [--restart-gateway] [--no-wait]
#   scripts/landfolk stop     [--players a,b,c] [--keep daemons|listener|supervisor|pauser|chat-wake|gateway]
#                             [--keep-gateway] [--no-reclaim] [--clear-roster]
#   scripts/landfolk enable   <player> [--mode auto|kanban|continuous]
#   scripts/landfolk disable  <player>
#   scripts/landfolk restart  <player|players|daemons|listener|supervisor|pauser|chat-wake|gateway|all>
#   scripts/landfolk status   [--json]
#   scripts/landfolk diagnostics [--players a,b,c] [--skip-deploy|--skip-gateway|--skip-dispatcher|--skip-daemons]
#                                [--sleep <s>] [--fail-fast]
#                                # incremental startup with per-phase health checks
#   scripts/landfolk deploy   [--dry-run]
#                                # sync repo skills/SOULs/config to runtime locations
#   scripts/landfolk version  # check which bots are running latest code (exit code = stale count)
#   scripts/landfolk logs     [agents|<player>|listener|supervisor|pauser|gateway] [opts]
#   scripts/landfolk chat     <player> "<message>"
#   scripts/landfolk fix      reconnect <p> | clean | tp <p> <x> <y> <z> | unstick <p>
#   scripts/landfolk players  list | show <player>
#   scripts/landfolk defaults                    # what `start` will do with no flags
#
# Defaults (override via env):
#   MC_HOST=192.168.1.202
#   BOT_MOVEMENT_PROFILE=slow
#   PLAYERS_DEFAULT=flint,mason,steward          (used when roster is empty)
#   LANDFOLK_DEFAULT_MODE=auto                   (auto resolves per-role)
#   LOG_DIR=/tmp/hermescraft
#   STATE_DIR=$LOG_DIR/state                     (CLI pidfiles + roster)
#   ROSTER_FILE=$LOG_DIR/active-players          (one "name mode" per line)
#
# Migration note: prior pidfiles under $LOG_DIR/session-state/ are
# auto-moved to $LOG_DIR/state/ on first invocation.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR"

# Ensure `mc` and `hermes` are on PATH for every subprocess we launch
# (gateway, bots, agents, kanban workers spawned by the embedded
# dispatcher which inherit gateway env). $HOME/.local/bin holds the
# user's symlink to the hermes CLI; $SCRIPT_DIR/bin holds the `mc`
# wrapper. Without this, gateway-spawned workers calling `mc` via the
# terminal tool would have to absolute-path to the shim each time.
export PATH="$SCRIPT_DIR/bin:$HOME/.local/bin:$PATH"

MC_HOST="${MC_HOST:-192.168.1.202}"
BOT_MOVEMENT_PROFILE="${BOT_MOVEMENT_PROFILE:-slow}"
PLAYERS_DEFAULT="${PLAYERS_DEFAULT:-${PROFILES_DEFAULT:-flint,mason,steward}}"
LOG_DIR="${LOG_DIR:-/tmp/hermescraft}"
STATE_DIR="${STATE_DIR:-$LOG_DIR/state}"
ROSTER_FILE="${ACTIVE_PROFILES_FILE:-$LOG_DIR/active-players}"
AGENT_MODELS_JSON="${AGENT_MODELS_JSON:-$SCRIPT_DIR/data/agent-models.json}"
RESOLVER="$SCRIPT_DIR/scripts/resolve-agent-model.py"
ENGINE="$SCRIPT_DIR/scripts/landfolk-control.sh"
DEFAULT_MODE="${LANDFOLK_DEFAULT_MODE:-auto}"

mkdir -p "$LOG_DIR" "$STATE_DIR"

# One-shot migration of pidfiles + roster from the legacy session-state
# layout (landfolk-session.sh era). Safe to re-run.
_migrate_legacy_state() {
  local legacy="$LOG_DIR/session-state"
  if [ -d "$legacy" ]; then
    local moved=0 f base
    for f in "$legacy"/*.pid; do
      [ -f "$f" ] || continue
      base="$(basename "$f")"
      if [ ! -f "$STATE_DIR/$base" ]; then
        mv "$f" "$STATE_DIR/$base" && moved=$((moved + 1))
      else
        rm -f "$f"
      fi
    done
    rmdir "$legacy" 2>/dev/null || true
    [ "$moved" -gt 0 ] && echo "  ${C_DIM}migrated $moved pidfile(s) from session-state/ → state/${C_RST}" >&2
  fi
  # Legacy roster file (no mode column). Upgrade it in-place.
  local legacy_roster="$LOG_DIR/active-profiles"
  if [ -f "$legacy_roster" ] && [ ! -f "$ROSTER_FILE" ]; then
    awk 'NF{print $1 " kanban"}' "$legacy_roster" > "$ROSTER_FILE"
    rm -f "$legacy_roster"
  fi
}

# ─── ANSI ──────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_ERR=$'\033[31m'
  C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'; C_RST=$'\033[0m'
else
  C_OK=""; C_WARN=""; C_ERR=""; C_DIM=""; C_BOLD=""; C_RST=""
fi
ok()   { echo "  ${C_OK}✓${C_RST} $*"; }
warn() { echo "  ${C_WARN}!${C_RST} $*"; }
err()  { echo "  ${C_ERR}✗${C_RST} $*" >&2; }
dim()  { echo "  ${C_DIM}$*${C_RST}"; }
h1()   { echo; echo "── $* ──"; }

usage() { sed -n '2,47p' "$0" | sed -E 's/^# ?//'; exit "${1:-0}"; }

_migrate_legacy_state

# ─── Roster helpers ────────────────────────────────────────────────────────

# Canonical roster from agent-models.json (lowercase, one per line).
canonical_players() {
  python3 "$RESOLVER" agent-names "$AGENT_MODELS_JSON" 2>/dev/null \
    | tr '[:upper:]' '[:lower:]' | awk 'NF'
}

is_canonical_player() {
  local p="$1" line
  while IFS= read -r line; do
    [ "$line" = "$p" ] && return 0
  done < <(canonical_players)
  return 1
}

player_api_port() {
  BASE_API_PORT="${BASE_API_PORT:-3001}" \
    python3 "$RESOLVER" api-port "$1" "$AGENT_MODELS_JSON" 2>/dev/null
}

player_viewer_port() {
  local api; api="$(player_api_port "$1")"
  [ -z "$api" ] && return 1
  echo $((api + 1000))
}

player_model()    { python3 "$RESOLVER" "$1" model    "$AGENT_MODELS_JSON" 2>/dev/null; }
player_provider() { python3 "$RESOLVER" "$1" provider "$AGENT_MODELS_JSON" 2>/dev/null; }

# Player role from agent-models.json (lowercase). Drives auto-mode pick.
player_role() {
  AGENT_MODELS_JSON="$AGENT_MODELS_JSON" python3 - "$1" <<'PY' 2>/dev/null
import json, os, sys
name = sys.argv[1]
with open(os.environ["AGENT_MODELS_JSON"]) as fh:
    data = json.load(fh)
agents = data.get("agents") or {}
for k, v in agents.items():
    if k.lower() == name.lower():
        print((v.get("role") or "").lower())
        break
PY
}

# Resolve `auto` to a concrete mode based on role. `kanban`/`continuous`
# pass through unchanged. Unknown modes default to kanban with a warning
# so the caller never proceeds with a meaningless value.
resolve_mode() {
  local player="$1" requested="${2:-auto}"
  case "$requested" in
    kanban|continuous) echo "$requested"; return ;;
    auto)
      case "$(player_role "$player")" in
        orchestrator) echo "continuous" ;;
        *)            echo "kanban" ;;
      esac
      ;;
    *) warn "unknown mode '$requested' for $player → using kanban" >&2; echo "kanban" ;;
  esac
}

# Convert a CSV (or empty → default) of players into a deduped lowercase
# list, validated against canonical names.
parse_players_csv() {
  local csv="${1:-$PLAYERS_DEFAULT}" out=() p key seen
  IFS=',' read -r -a parts <<< "$csv"
  for p in "${parts[@]}"; do
    key="$(echo "$p" | tr '[:upper:]' '[:lower:]' | xargs)"
    [ -z "$key" ] && continue
    if ! is_canonical_player "$key"; then
      err "unknown player: $p (try: scripts/landfolk players list)"; return 1
    fi
    seen=0
    for s in "${out[@]:-}"; do [ "$s" = "$key" ] && { seen=1; break; }; done
    [ "$seen" = 0 ] && out+=("$key")
  done
  printf '%s\n' "${out[@]:-}"
}

# Roster file format: one line "name mode" (mode ∈ auto|kanban|continuous).
# `auto` is stored as intent and re-resolved on every start (so role edits
# in agent-models.json take effect without rewriting the roster).
roster_players() {
  [ -f "$ROSTER_FILE" ] || return 0
  awk 'NF && $1 !~ /^#/ {print tolower($1)}' "$ROSTER_FILE"
}
roster_mode_for() {
  local target="$1"
  [ -f "$ROSTER_FILE" ] || { echo "$DEFAULT_MODE"; return; }
  local line m
  line="$(awk -v t="$target" 'tolower($1)==t {print; exit}' "$ROSTER_FILE")"
  m="$(echo "$line" | awk '{print $2}')"
  echo "${m:-$DEFAULT_MODE}"
}
roster_upsert() {
  local name="$1" mode="${2:-$DEFAULT_MODE}" tmp
  tmp="$(mktemp "${ROSTER_FILE}.XXXX")"
  [ -f "$ROSTER_FILE" ] && awk -v t="$name" 'tolower($1)!=t' "$ROSTER_FILE" > "$tmp" || true
  printf '%s %s\n' "$name" "$mode" >> "$tmp"
  mv "$tmp" "$ROSTER_FILE"
}
roster_remove() {
  local name="$1" tmp
  [ -f "$ROSTER_FILE" ] || return 0
  tmp="$(mktemp "${ROSTER_FILE}.XXXX")"
  awk -v t="$name" 'tolower($1)!=t' "$ROSTER_FILE" > "$tmp"
  mv "$tmp" "$ROSTER_FILE"
}
# Seed the roster from PLAYERS_DEFAULT if the roster file doesn't exist
# yet. Stickyness means we only do this once — subsequent runs honor the
# user's enable/disable history.
roster_seed_if_empty() {
  [ -f "$ROSTER_FILE" ] && return 0
  local p
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    roster_upsert "$p" "$DEFAULT_MODE"
  done < <(parse_players_csv "$PLAYERS_DEFAULT")
}

# ─── Daemon helpers (operator-side, owned by this CLI) ────────────────────
# Maps short daemon name → script path. Pidfiles under $STATE_DIR.

daemon_script() {
  case "$1" in
    listener)   echo "$SCRIPT_DIR/scripts/steward-chat-listener.py" ;;
    supervisor) echo "$SCRIPT_DIR/scripts/steward-supervisor.py" ;;
    pauser)     echo "$SCRIPT_DIR/scripts/inactive-cards-pauser.py" ;;
    chat-wake)  echo "$SCRIPT_DIR/scripts/landfolk-chat-wake.py" ;;
    cognition)  echo "$SCRIPT_DIR/scripts/landfolk-cognition-record.py" ;;
    *)          return 1 ;;
  esac
}

# Long pidfile name for legacy compatibility (matches files migrated from
# session-state/).
daemon_pidfile() {
  case "$1" in
    listener)   echo "$STATE_DIR/steward-chat-listener.pid" ;;
    supervisor) echo "$STATE_DIR/steward-supervisor.pid" ;;
    pauser)     echo "$STATE_DIR/inactive-cards-pauser.pid" ;;
    chat-wake)  echo "$STATE_DIR/landfolk-chat-wake.pid" ;;
    cognition)  echo "$STATE_DIR/landfolk-cognition-record.pid" ;;
  esac
}

daemon_pid()   { cat "$(daemon_pidfile "$1")" 2>/dev/null || true; }
daemon_alive() { local p; p="$(daemon_pid "$1")"; [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

daemon_start() {
  local name="$1" extra_env="${2:-}" script log pidf
  script="$(daemon_script "$name")" || { err "unknown daemon: $name"; return 1; }
  pidf="$(daemon_pidfile "$name")"
  log="$LOG_DIR/$(basename "$script" .py).log"
  if daemon_alive "$name"; then
    warn "$name already running (pid $(daemon_pid "$name"))"; return 0
  fi
  (
    cd "$SCRIPT_DIR"
    # shellcheck disable=SC2086
    nohup env $extra_env python3 -u "$script" >"$log" 2>&1 &
    echo $! > "$pidf"
    disown
  )
  sleep 1
  if daemon_alive "$name"; then
    ok "$name started (pid $(daemon_pid "$name")) — log $log"
  else
    err "$name failed to start; see $log"
    tail -5 "$log" 2>/dev/null | sed 's/^/    /'
  fi
}

daemon_stop() {
  local name="$1" pid pidf script_basename
  pid="$(daemon_pid "$name")"
  pidf="$(daemon_pidfile "$name")"
  script_basename="$(basename "$(daemon_script "$name")")"
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    dim "$name not running"
    rm -f "$pidf"
    pkill -f "scripts/$script_basename" 2>/dev/null && warn "killed orphan $name process(es)" || true
    return 0
  fi
  kill "$pid" 2>/dev/null || true
  sleep 1
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null && warn "$name (pid $pid) force-killed (SIGKILL)" || err "$name (pid $pid) won't die"
  else
    ok "$name (pid $pid) stopped"
  fi
  rm -f "$pidf"
  pkill -f "scripts/$script_basename" 2>/dev/null || true
}

# ─── Player (bot) helpers — delegate to engine ─────────────────────────────

# Bring one player up in the requested mode. Engine handles bot + watchdog.
# Kanban mode passes --no-agent so we never spawn the continuous agent at
# all (the old script started it then SIGKILLed it — a race).
player_start_one() {
  local player="$1" mode="${2:-$DEFAULT_MODE}"
  local port vport
  port="$(player_api_port "$player")"
  vport="$(player_viewer_port "$player")"
  [ -z "$port" ] && { err "$player has no api_port in $AGENT_MODELS_JSON"; return 1; }

  local engine_args=( enable --profiles "$player" )
  local engine_env=( "MC_HOST=$MC_HOST" "VIEWER_PORT=$vport" "BOT_MOVEMENT_PROFILE=$BOT_MOVEMENT_PROFILE" )
  if [ "$mode" = "kanban" ]; then
    engine_args+=( --no-agent )
    engine_env+=( "WATCHDOG_CONNECT_ONLY=1" )
  fi
  # Steward's danger-react still runs (flee/fight + watchdog log), but the chat
  # broadcast is silenced — her ~25s low-hp alerts were dominating every nearby
  # bot's chat queue. Per-bot watchdog alerts on Flint/Mason remain.
  case "$(printf '%s' "$player" | tr '[:upper:]' '[:lower:]')" in
    steward) engine_env+=( "DANGER_AUTOREACT_BROADCAST_CHAT=false" );;
  esac
  # shellcheck disable=SC2086
  env "${engine_env[@]}" "$ENGINE" "${engine_args[@]}" >>"$LOG_DIR/landfolk-control.log" 2>&1 || true

  if [ "${LANDFOLK_NO_WAIT:-0}" = "1" ]; then
    ok "$player launching (port=$port, mode=$mode; not waiting for connect)"
    return 0
  fi

  local i=0
  until curl -sf "http://127.0.0.1:$port/health" 2>/dev/null \
        | python3 -c "import sys,json;d=json.load(sys.stdin);sys.exit(0 if d.get('connected')==True else 1)" 2>/dev/null; do
    i=$((i + 1))
    if [ $i -gt 30 ]; then
      err "$player didn't connect within 60s (check $LOG_DIR/bot-$player.log)"
      return 1
    fi
    sleep 2
  done
  ok "$player up (port=$port, viewer=:$vport, mode=$mode)"
}

player_stop_one() {
  local player="$1"
  "$ENGINE" stop --profiles "$player" >>"$LOG_DIR/landfolk-control.log" 2>&1 || true
  ok "$player stopped"
}

# List hermes kanban-worker processes for a player (or all canonical
# players if no arg given). Prints lines of the form "<pid> <task_id>".
kanban_workers_for() {
  local player="${1:-}"
  local pat
  if [ -n "$player" ]; then
    pat="hermes -p $player .* kanban task "
  else
    pat="hermes -p [a-z][a-z]* .* kanban task "
  fi
  # ps with full argv, then extract pid + the task id after `kanban task`.
  ps -eo pid=,command= 2>/dev/null \
    | awk -v re="$pat" '
        $0 ~ re {
          pid=$1
          for (i=1; i<=NF; i++) {
            if ($i=="task" && (i+1)<=NF) { print pid, $(i+1); next }
          }
        }'
}

# After the bots are dead, no kanban worker for our players has any reason
# to be alive. SIGTERM whatever's left (typically zero — but cleans up
# anything that escaped reclaim, like workers for tasks the gateway hadn't
# reported as `running` yet, or workers whose reclaim raced with start_run).
kanban_worker_sweep() {
  local scope_csv="${1:-}"   # comma-separated players, or empty = all
  local -a scope=()
  if [ -n "$scope_csv" ]; then
    IFS=',' read -r -a scope <<< "$scope_csv"
  else
    while IFS= read -r p; do [ -n "$p" ] && scope+=( "$p" ); done < <(canonical_players)
  fi
  local found=0 p pid tid
  for p in "${scope[@]}"; do
    while read -r pid tid; do
      [ -z "$pid" ] && continue
      kill "$pid" 2>/dev/null && { warn "killed stray worker $p pid=$pid task=$tid"; found=$((found+1)); }
    done < <(kanban_workers_for "$p")
  done
  if [ "$found" -gt 0 ]; then
    sleep 2
    for p in "${scope[@]}"; do
      while read -r pid tid; do
        [ -z "$pid" ] && continue
        kill -9 "$pid" 2>/dev/null && warn "force-killed worker $p pid=$pid task=$tid"
      done < <(kanban_workers_for "$p")
    done
  fi
}

# Cards on landfolk-ops that are still `running` are reclaimed so kanban
# workers exit cleanly before we touch their bots.
#
# Reclaim alone only releases the kanban lock — the worker process keeps
# running (and keeps calling mc against a soon-to-be-dead bot). So we also
# SIGTERM any hermes process whose argv contains `kanban task <tid>`.
# A 2-second grace then SIGKILL anything that survived.
reclaim_running() {
  local board="landfolk-ops" filter="${1:-}"
  local cmd=( hermes kanban --board "$board" list )
  [ -n "$filter" ] && cmd+=( --assignee "$filter" )
  "${cmd[@]}" 2>/dev/null \
    | awk '$3=="running"{print $2}' \
    | while read -r tid; do
        [ -z "$tid" ] && continue
        if hermes kanban --board "$board" reclaim "$tid" \
            --reason "landfolk stop${filter:+ $filter}" >/dev/null 2>&1; then
          dim "reclaimed $tid"
          # Match `... kanban task <tid>` literally (avoid partial matches).
          local pids
          pids="$(pgrep -f "kanban task $tid\$" 2>/dev/null || true)"
          if [ -n "$pids" ]; then
            kill $pids 2>/dev/null || true
            dim "  signalled worker pid(s) $pids"
            # Give them a moment to finish their last mc call, then force.
            sleep 2
            local still
            still="$(pgrep -f "kanban task $tid\$" 2>/dev/null || true)"
            if [ -n "$still" ]; then
              kill -9 $still 2>/dev/null || true
              warn "  force-killed unresponsive worker pid(s) $still"
            fi
          fi
        fi
      done || true
}

# ─── Verbs ─────────────────────────────────────────────────────────────────

# Detect a running hermes gateway. Two invocation styles produce different
# argv (and the old `hermes_cli.*gateway` pattern only matched one):
#   - Manual: `python -m hermes_cli.main gateway run --replace`
#   - Via shim: `python /Users/foz/.local/bin/hermes gateway run --replace`
# Both contain `gateway run` in argv. Falls back to `hermes gateway status`
# (the official check) when pgrep is unavailable or returns nothing.
gateway_running() {
  # Match the literal `hermes gateway run` argv signature — the bare
  # `gateway run` substring also matched unrelated scripts that happen
  # to contain the phrase (e.g. monitoring heredocs), causing false
  # positives.
  pgrep -f "hermes gateway run" >/dev/null 2>&1 && return 0
  command -v hermes >/dev/null 2>&1 || return 1
  hermes gateway status >/dev/null 2>&1
}

cmd_start() {
  local players_csv="" mode_override="" continuous_csv="" no_wait=0
  # Gateway is part of the session by default — `landfolk start` manages it.
  # Use `--no-gateway` to leave whatever is running untouched. Use
  # `--restart-gateway` to force a `hermes gateway run --replace` (useful
  # after pulling new gateway code so the dispatcher / config knobs reload).
  local with_listener=1 with_supervisor=0 with_pauser=0 with_chatwake=1 with_gateway=1 with_cognition=1 restart_gateway=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --players)    players_csv="$2"; shift 2 ;;
      --mode)       mode_override="$2"; shift 2 ;;
      --continuous) continuous_csv="$2"; shift 2 ;;
      --no-wait)    no_wait=1; shift ;;
      --with-gateway)    with_gateway=1; shift ;;  # back-compat — now the default
      --no-gateway)      with_gateway=0; shift ;;
      --restart-gateway) with_gateway=1; restart_gateway=1; shift ;;
      --without)
        IFS=',' read -r -a parts <<< "$2"
        for w in "${parts[@]}"; do
          case "$w" in
            daemons)    with_listener=0; with_supervisor=0; with_pauser=0; with_chatwake=0 ;;
            listener)   with_listener=0 ;;
            supervisor) with_supervisor=0 ;;
            pauser)     with_pauser=0 ;;
            chat-wake)  with_chatwake=0 ;;
            cognition)  with_cognition=0 ;;
            gateway)    with_gateway=0 ;;
            *) err "unknown --without target: $w"; return 1 ;;
          esac
        done
        shift 2 ;;
      --no-listener)   with_listener=0; shift ;;
      --no-supervisor) with_supervisor=0; shift ;;
      --no-pauser)     with_pauser=0; shift ;;
      --no-chat-wake)  with_chatwake=0; shift ;;
      --no-cognition)  with_cognition=0; shift ;;
      -h|--help) usage 0 ;;
      *) err "unknown flag: $1"; return 1 ;;
    esac
  done
  case "${mode_override:-auto}" in auto|kanban|continuous) ;; *) err "invalid --mode: $mode_override (auto|kanban|continuous)"; return 1 ;; esac

  [ "$no_wait" = 1 ] && export LANDFOLK_NO_WAIT=1

  # Build the player list. Precedence:
  #   --players → explicit, transient (does NOT mutate roster).
  #   else: existing roster → sticky.
  #   else: seed roster from PLAYERS_DEFAULT (one-time), then use it.
  local players_list source_label
  if [ -n "$players_csv" ]; then
    players_list="$(parse_players_csv "$players_csv")" || return 1
    source_label="--players flag (transient; roster unchanged)"
  else
    roster_seed_if_empty
    players_list="$(roster_players)"
    source_label="roster $ROSTER_FILE (sticky)"
  fi
  [ -z "$players_list" ] && { err "no players to start (set PLAYERS_DEFAULT or use --players / enable)"; return 1; }

  # Per-player mode resolution. Three precedence levels (low → high):
  #   1. roster's stored mode (default `auto` for newly-seeded)
  #   2. --mode <m>          (overrides for THIS run, all players)
  #   3. --continuous a,b,c  (overrides those specific players to continuous)
  declare -A PMODE
  local continuous_set=""
  if [ -n "$continuous_csv" ]; then
    local pl
    pl="$(parse_players_csv "$continuous_csv")" || return 1
    continuous_set=" $(echo "$pl" | tr '\n' ' ')"
  fi
  local p stored eff
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    if [ -n "$mode_override" ]; then
      eff="$mode_override"
    else
      stored="$(roster_mode_for "$p")"
      eff="$stored"
    fi
    case " $continuous_set " in *" $p "*) eff="continuous" ;; esac
    PMODE["$p"]="$(resolve_mode "$p" "$eff")"
  done <<< "$players_list"

  # ─── plan (print BEFORE acting so the user sees what's about to happen)
  h1 "plan"
  echo "  source:    $source_label"
  echo "  default:   mode=$DEFAULT_MODE (auto = orchestrator→continuous, else→kanban)"
  local plan_parts=""
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    plan_parts="${plan_parts:+$plan_parts, }$p=${PMODE[$p]}"
  done <<< "$players_list"
  echo "  players:   $plan_parts"
  local daemon_parts=""
  [ "$with_listener"   = 1 ] && daemon_parts="${daemon_parts:+$daemon_parts, }listener"
  [ "$with_supervisor" = 1 ] && daemon_parts="${daemon_parts:+$daemon_parts, }supervisor"
  [ "$with_pauser"     = 1 ] && daemon_parts="${daemon_parts:+$daemon_parts, }pauser"
  [ "$with_chatwake"   = 1 ] && daemon_parts="${daemon_parts:+$daemon_parts, }chat-wake"
  [ "$with_cognition"  = 1 ] && daemon_parts="${daemon_parts:+$daemon_parts, }cognition-recorder"
  echo "  daemons:   ${daemon_parts:-none}"
  if [ "$with_gateway" = 1 ]; then
    if [ "$restart_gateway" = 1 ]; then
      echo "  gateway:   force-restart (--restart-gateway → hermes gateway run --replace)"
    else
      echo "  gateway:   ensure running (default; --no-gateway to skip)"
    fi
  else
    echo "  gateway:   observe only (--no-gateway)"
  fi

  # ─── execute
  h1 "starting players"
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    player_start_one "$p" "${PMODE[$p]}" || warn "$p start had errors (see logs)"
    # Only persist roster entries when we're acting on the roster set.
    # `--players` is transient, so don't mutate sticky state.
    if [ -z "$players_csv" ]; then
      # Preserve stored mode if it's `auto`; otherwise sync to effective.
      local stored2; stored2="$(roster_mode_for "$p")"
      [ "$stored2" = "auto" ] || roster_upsert "$p" "${PMODE[$p]}"
    fi
  done <<< "$players_list"

  if [ "$with_listener" = 1 ];   then h1 "starting daemon: listener";   daemon_start listener;   fi
  if [ "$with_supervisor" = 1 ]; then h1 "starting daemon: supervisor"; daemon_start supervisor; fi
  if [ "$with_pauser" = 1 ];     then h1 "starting daemon: pauser";     ACTIVE_PROFILES_FILE="$ROSTER_FILE" daemon_start pauser "ACTIVE_PROFILES_FILE=$ROSTER_FILE"; fi
  if [ "$with_chatwake" = 1 ];   then h1 "starting daemon: chat-wake";  daemon_start chat-wake; fi

  if [ "$with_gateway" = 1 ]; then
    h1 "hermes gateway"
    if ! command -v hermes >/dev/null 2>&1; then
      err "hermes CLI not on PATH — cannot manage gateway"
    elif [ "$restart_gateway" = 1 ]; then
      # Force replace: useful after gateway code changes (e.g. dispatcher
      # config knobs like per_assignee_cap) so the in-memory dispatcher
      # picks up new defaults.
      nohup hermes gateway run --replace >>"$LOG_DIR/gateway.log" 2>&1 &
      disown
      sleep 2
      gateway_running \
        && ok "hermes gateway replaced (log $LOG_DIR/gateway.log)" \
        || err "hermes gateway didn't come back up; check $LOG_DIR/gateway.log"
    elif gateway_running; then
      ok "hermes gateway already running"
    else
      nohup hermes gateway run --replace >>"$LOG_DIR/gateway.log" 2>&1 &
      disown
      sleep 2
      gateway_running \
        && ok "hermes gateway started (log $LOG_DIR/gateway.log)" \
        || err "hermes gateway didn't come up; check $LOG_DIR/gateway.log"
    fi
  fi

  # Out-of-process kanban dispatcher loop. The gateway-embedded dispatcher
  # (kanban.dispatch_in_gateway: true) wedges silently — see
  # scripts/landfolk-dispatcher.sh header for the full rationale.
  if [ "$with_gateway" = 1 ]; then
    h1 "kanban dispatcher"
    if pgrep -f 'landfolk-dispatcher\.sh' >/dev/null 2>&1; then
      ok "dispatcher already running (log $LOG_DIR/dispatcher.log)"
    else
      nohup "$SCRIPT_DIR/scripts/landfolk-dispatcher.sh" >/dev/null 2>&1 &
      disown
      sleep 1
      pgrep -f 'landfolk-dispatcher\.sh' >/dev/null 2>&1 \
        && ok "dispatcher started (log $LOG_DIR/dispatcher.log)" \
        || err "dispatcher didn't come up; check $LOG_DIR/dispatcher.log"
    fi
  fi

  if [ "$with_cognition" = 1 ]; then
    h1 "cognition recorder"
    if daemon_alive cognition; then
      ok "cognition-recorder already running (log $LOG_DIR/landfolk-cognition-record.log)"
    else
      daemon_start cognition
    fi
  fi

  h1 "ready"
  cmd_status
}

cmd_stop() {
  local players_csv="" do_reclaim=1 clear_roster=0
  # Gateway IS stopped on a full down by default — `landfolk stop` owns the
  # whole session. Narrowed stops (`--players X`) leave the gateway alone
  # since other players might still need it. Use `--keep-gateway` to leave
  # it running even on a full down.
  local with_gateway=1 keep_listener=0 keep_supervisor=0 keep_pauser=0 keep_chatwake=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --players) players_csv="$2"; shift 2 ;;
      --keep)
        IFS=',' read -r -a parts <<< "$2"
        for k in "${parts[@]}"; do
          case "$k" in
            daemons)    keep_listener=1; keep_supervisor=1; keep_pauser=1; keep_chatwake=1 ;;
            listener)   keep_listener=1 ;;
            supervisor) keep_supervisor=1 ;;
            pauser)     keep_pauser=1 ;;
            chat-wake)  keep_chatwake=1 ;;
            gateway)    with_gateway=0 ;;
            *) err "unknown --keep target: $k"; return 1 ;;
          esac
        done
        shift 2 ;;
      --keep-listener)   keep_listener=1; shift ;;
      --keep-supervisor) keep_supervisor=1; shift ;;
      --keep-pauser)     keep_pauser=1; shift ;;
      --keep-chat-wake)  keep_chatwake=1; shift ;;
      --keep-gateway)    with_gateway=0; shift ;;
      --with-gateway)    with_gateway=1; shift ;;  # back-compat — now the default
      --no-gateway)      with_gateway=0; shift ;;
      --no-reclaim)      do_reclaim=0; shift ;;
      --clear-roster)    clear_roster=1; shift ;;
      -h|--help) usage 0 ;;
      *) err "unknown flag: $1"; return 1 ;;
    esac
  done

  # Narrowed `--players X`: only stop those players, never the gateway.
  # The gateway is shared infrastructure across the whole session.
  if [ -n "$players_csv" ]; then
    with_gateway=0
  fi

  if [ -z "$players_csv" ] && [ "$do_reclaim" = 1 ]; then
    h1 "reclaiming running kanban workers"
    reclaim_running
  fi

  if [ "$keep_supervisor" != 1 ]; then h1 "stopping supervisor"; daemon_stop supervisor; fi
  if [ "$keep_listener"   != 1 ]; then h1 "stopping listener";   daemon_stop listener;   fi
  if [ "$keep_chatwake"   != 1 ]; then h1 "stopping chat-wake";  daemon_stop chat-wake;  fi
  # Pauser stops only on full-down (no --players narrowing). Roster is
  # NOT wiped unless --clear-roster: stop is supposed to be reversible by
  # `start` without re-listing players. enable/disable manage stickyness.
  if [ -z "$players_csv" ]; then
    if [ "$keep_pauser" != 1 ]; then
      h1 "stopping pauser"; daemon_stop pauser
    fi
    if [ "$clear_roster" = 1 ]; then
      rm -f "$ROSTER_FILE" 2>/dev/null && dim "cleared $ROSTER_FILE"
    else
      dim "roster preserved at $ROSTER_FILE (use --clear-roster to wipe)"
    fi
  fi

  h1 "stopping players"
  local scope_csv
  if [ -z "$players_csv" ]; then
    scope_csv="$(canonical_players | paste -sd, -)"
  else
    scope_csv="$(parse_players_csv "$players_csv")" || return 1
    scope_csv="$(echo "$scope_csv" | paste -sd, -)"
  fi

  # Build a "name=mode" map for the players in scope so we can annotate
  # the engine's `[agent] X not tracked` lines: kanban → "(none expected)",
  # continuous → "(MISSING — agent failed to start; check landfolk-control.log)".
  # Unknown roster entries (transient --players) fall back to effective mode.
  local mode_map="" _p _stored _eff
  IFS=',' read -r -a _scope_arr <<< "$scope_csv"
  for _p in "${_scope_arr[@]}"; do
    [ -z "$_p" ] && continue
    _stored="$(roster_mode_for "$_p")"
    _eff="$(resolve_mode "$_p" "${_stored:-$DEFAULT_MODE}")"
    mode_map="${mode_map}${_p}=${_eff};"
  done

  "$ENGINE" stop --profiles "$scope_csv" 2>&1 \
    | grep -E "stopped|not running|not tracked" \
    | MODE_MAP="$mode_map" awk '
        BEGIN {
          n = split(ENVIRON["MODE_MAP"], pairs, ";")
          for (i=1; i<=n; i++) {
            if (pairs[i] == "") continue
            eq = index(pairs[i], "=")
            if (eq > 0) mode[tolower(substr(pairs[i], 1, eq-1))] = substr(pairs[i], eq+1)
          }
        }
        {
          # Lines look like: "[agent] Steward not tracked"
          if (match($0, /^\[(agent|bot|watchdog)\] [A-Za-z]+/)) {
            kind  = substr($0, 2, index($0,"]")-2)
            rest  = substr($0, index($0,"]")+2)
            split(rest, parts, " ")
            name = tolower(parts[1])
            tag = ""
            if (kind == "agent" && index($0, "not tracked") > 0) {
              m = mode[name]
              if (m == "kanban")     tag = " (none expected)"
              else if (m == "continuous") tag = " (MISSING — agent failed to start; check landfolk-control.log)"
            }
            print "  " $0 tag
            next
          }
          print "  " $0
        }'

  # Belt-and-braces: now that bots are dead, sweep any surviving kanban
  # workers (reclaim races, gateway-spawned workers we never saw, etc).
  kanban_worker_sweep "$scope_csv"

  if [ -z "$players_csv" ] && daemon_alive cognition; then
    h1 "stopping cognition recorder"
    daemon_stop cognition
  fi

  if [ "$with_gateway" = 1 ]; then
    h1 "stopping kanban dispatcher"
    if pgrep -f 'landfolk-dispatcher\.sh' >/dev/null 2>&1; then
      pkill -TERM -f 'landfolk-dispatcher\.sh' 2>/dev/null && ok "dispatcher stopped" \
        || warn "pkill returned non-zero"
    else
      dim "dispatcher not running"
    fi

    h1 "stopping hermes gateway"
    if ! command -v hermes >/dev/null 2>&1; then
      warn "hermes CLI not on PATH — leaving gateway alone"
    elif ! gateway_running; then
      dim "hermes gateway not running"
    elif hermes gateway stop >/dev/null 2>&1; then
      ok "hermes gateway stopped"
    else
      warn "hermes gateway stop returned non-zero"
    fi
  else
    dim "hermes gateway left running (--keep-gateway or --players narrowing)"
  fi

  ok "session down"
}

cmd_enable() {
  local player="${1:-}"; shift || true
  [ -z "$player" ] && { err "enable needs a player name"; return 1; }
  local stored="$DEFAULT_MODE"
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode) stored="$2"; shift 2 ;;
      *) err "unknown flag: $1"; return 1 ;;
    esac
  done
  case "$stored" in auto|kanban|continuous) ;; *) err "invalid --mode: $stored"; return 1 ;; esac
  local pl; pl="$(parse_players_csv "$player")" || return 1
  local eff; eff="$(resolve_mode "$pl" "$stored")"
  echo "  ${C_DIM}enable $pl: stored=$stored, effective=$eff${C_RST}"
  roster_upsert "$pl" "$stored"
  player_start_one "$pl" "$eff"
}

cmd_disable() {
  local player="${1:-}"
  [ -z "$player" ] && { err "disable needs a player name"; return 1; }
  local pl; pl="$(parse_players_csv "$player")" || return 1
  reclaim_running "$pl"
  player_stop_one "$pl"
  roster_remove "$pl"
  dim "disabled $pl (removed from roster — won't auto-start next time)"
}

cmd_restart() {
  local target="${1:-}"
  [ -z "$target" ] && { err "restart needs a target"; return 1; }
  case "$target" in
    players|all-bots)
      local roster
      roster="$(roster_players)"
      [ -z "$roster" ] && { err "roster empty — nothing to restart"; return 1; }
      while IFS= read -r p; do [ -n "$p" ] && { reclaim_running "$p"; player_stop_one "$p"; }; done <<< "$roster"
      sleep 1
      local stored eff
      while IFS= read -r p; do
        [ -z "$p" ] && continue
        stored="$(roster_mode_for "$p")"
        eff="$(resolve_mode "$p" "$stored")"
        player_start_one "$p" "$eff"
      done <<< "$roster"
      ;;
    daemons)
      for d in listener supervisor pauser chat-wake cognition; do daemon_stop "$d"; done
      daemon_start listener
      daemon_start supervisor
      ACTIVE_PROFILES_FILE="$ROSTER_FILE" daemon_start pauser "ACTIVE_PROFILES_FILE=$ROSTER_FILE"
      daemon_start chat-wake
      daemon_start cognition
      ;;
    listener|supervisor|chat-wake|cognition)
      daemon_stop "$target"; daemon_start "$target" ;;
    pauser)
      daemon_stop pauser
      ACTIVE_PROFILES_FILE="$ROSTER_FILE" daemon_start pauser "ACTIVE_PROFILES_FILE=$ROSTER_FILE" ;;
    gateway)
      if command -v hermes >/dev/null 2>&1; then
        hermes gateway stop >/dev/null 2>&1 || true
        hermes gateway run --replace >/dev/null 2>&1 &
        disown
        ok "hermes gateway restart requested"
      else
        err "hermes CLI not on PATH"
      fi
      ;;
    all)
      cmd_stop
      sleep 1
      cmd_start ;;
    *)
      # Treat as a player name
      if is_canonical_player "$(echo "$target" | tr '[:upper:]' '[:lower:]')"; then
        local p="$(echo "$target" | tr '[:upper:]' '[:lower:]')"
        local stored eff
        stored="$(roster_mode_for "$p")"
        eff="$(resolve_mode "$p" "$stored")"
        reclaim_running "$p"
        player_stop_one "$p"
        sleep 1
        player_start_one "$p" "$eff"
      else
        err "unknown restart target: $target"
        return 1
      fi
      ;;
  esac
}

cmd_status() {
  local want_json=0
  [ "${1:-}" = "--json" ] && want_json=1

  if [ "$want_json" = 1 ]; then
    python3 - <<'PYEOF'
import json, subprocess, urllib.request, os
players = subprocess.run(["python3", os.environ["RESOLVER"], "agent-names", os.environ["AGENT_MODELS_JSON"]],
                         capture_output=True, text=True).stdout.split()
out = {"players": {}}
for raw in players:
    p = raw.lower()
    port = subprocess.run(["python3", os.environ["RESOLVER"], "api-port", raw, os.environ["AGENT_MODELS_JSON"]],
                          capture_output=True, text=True).stdout.strip()
    rec = {"port": int(port) if port else None}
    if port:
        try:
            r = urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=1)
            d = json.loads(r.read())
            rec.update({"connected": d.get("connected"), "pos": d.get("position"),
                        "holding": d.get("holding"), "uptime": d.get("uptime_sec")})
        except Exception:
            rec["reachable"] = False
    out["players"][p] = rec
print(json.dumps(out, indent=2))
PYEOF
    return
  fi

  h1 "MC server ($MC_HOST:25565)"
  nc -z -w 2 "$MC_HOST" 25565 >/dev/null 2>&1 && ok "reachable" || err "unreachable"

  h1 "players"
  printf "  %-10s %-10s %-6s %-9s %-22s %-14s %s\n" "name" "mode" "port" "viewer" "position" "holding" "uptime"
  local p port vport mode info connected pos holding uptime conn_mark
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    port="$(player_api_port "$p")"
    vport="$(player_viewer_port "$p")"
    mode="$(roster_mode_for "$p")"
    info="$(curl -sf "http://127.0.0.1:$port/health" 2>/dev/null \
      | python3 -c "
import sys, json
try:
    d=json.load(sys.stdin); pos=d.get('position') or {}
    print(f\"connected={d.get('connected')};pos={pos.get('x',0):.1f},{pos.get('y',0):.1f},{pos.get('z',0):.1f};holding={d.get('holding') or 'none'};uptime={d.get('uptime_sec',0)}\")
except Exception: pass" 2>/dev/null || true)"
    if [ -z "$info" ]; then
      printf "  %-10s %-10s %-6s %-9s %-22s %-14s %s\n" "$p" "$mode" "${port:-?}" ":${vport:-?}" "DOWN" "-" "-"
    else
      connected="$(echo "$info" | sed -E 's/.*connected=([^;]*).*/\1/')"
      pos="$(echo "$info" | sed -E 's/.*pos=([^;]*).*/\1/')"
      holding="$(echo "$info" | sed -E 's/.*holding=([^;]*).*/\1/')"
      uptime="$(echo "$info" | sed -E 's/.*uptime=([^;]*).*/\1/')"
      [ "$connected" = "True" ] && conn_mark="${C_OK}OK${C_RST}" || conn_mark="${C_ERR}--${C_RST}"
      printf "  %-10s %-10s %-6s %-9s %b %-19s %-14s %ss\n" "$p" "$mode" "$port" ":$vport" "$conn_mark" "$pos" "$holding" "$uptime"
    fi
  done < <(canonical_players)

  h1 "daemons"
  for d in listener supervisor pauser chat-wake cognition; do
    if daemon_alive "$d"; then ok "$d running (pid $(daemon_pid "$d"))"
    else dim "$d stopped"; fi
  done

  h1 "ambient services"
  if gateway_running; then ok "hermes gateway running"; else warn "hermes gateway NOT running (run: hermes gateway run --replace)"; fi
  if pgrep -f 'landfolk-dispatcher\.sh' >/dev/null 2>&1; then ok "kanban dispatcher running"; else warn "kanban dispatcher NOT running (run: scripts/landfolk-dispatcher.sh)"; fi
  if [ -d "$LOG_DIR/cognition" ]; then
    dim "cognition JSONL: $LOG_DIR/cognition/*.jsonl (recorder: scripts/landfolk-cognition-record.py)"
  fi
  if lsof -nP -iTCP:9119 -sTCP:LISTEN 2>/dev/null | grep -q LISTEN; then ok "hermes dashboard on :9119"; else dim "hermes dashboard not listening"; fi

  # Watchdog heartbeat staleness — alerts when a watchdog subshell has died
  # silently or wedged. Each watchdog touches its heartbeat file once per
  # WATCHDOG_INTERVAL_S (default 8s); if the file is older than 3× that, the
  # supervisor loop is no longer running. See investigation 2026-05-25.
  local _wd_threshold="${WATCHDOG_HEARTBEAT_STALE_S:-24}"
  local _wd_now; _wd_now="$(date +%s)"
  for _hb in "$LOG_DIR"/watchdog-*.heartbeat; do
    [ -e "$_hb" ] || continue
    local _hb_age _hb_who
    _hb_age=$(( _wd_now - $(stat -f %m "$_hb" 2>/dev/null || echo "$_wd_now") ))
    _hb_who="$(basename "$_hb" .heartbeat | sed 's/^watchdog-//')"
    if [ "$_hb_age" -gt "$_wd_threshold" ]; then
      warn "watchdog-$_hb_who heartbeat stale (${_hb_age}s ago, threshold ${_wd_threshold}s) — process may be dead or wedged"
    fi
  done

  h1 "kanban (landfolk-ops)"
  if command -v hermes >/dev/null 2>&1; then
    hermes kanban --board landfolk-ops stats 2>&1 | grep -E "By status|running|blocked|ready|todo|done" | head -8 | sed 's/^/  /' || true
  fi

  h1 "kanban workers"
  # Workers spawned by the gateway show up in ps as
  #   hermes -p <player> --skills kanban-worker chat -q work kanban task <tid>
  # A worker is "live" if its task is still in `running` on the board;
  # otherwise it's a stale orphan (reclaim raced, gateway crash, etc.) and
  # `landfolk stop` (or `fix clean`) should sweep it.
  local _running_tids=""
  if command -v hermes >/dev/null 2>&1; then
    _running_tids="$(hermes kanban --board landfolk-ops list 2>/dev/null | awk '$3=="running"{print $2}' | paste -sd, -)"
  fi
  local _worker_total=0 _stale_total=0
  local _p _w_count _stale_lines=""
  while IFS= read -r _p; do
    [ -z "$_p" ] && continue
    _w_count=0
    while read -r _pid _tid; do
      [ -z "$_pid" ] && continue
      _worker_total=$((_worker_total + 1))
      _w_count=$((_w_count + 1))
      if [ -n "$_running_tids" ] && echo ",$_running_tids," | grep -q ",$_tid,"; then
        :
      else
        _stale_total=$((_stale_total + 1))
        _stale_lines+="    ${C_WARN}stale${C_RST} $_p pid=$_pid task=$_tid (not in running)"$'\n'
      fi
    done < <(kanban_workers_for "$_p")
    if [ "$_w_count" -gt 0 ]; then
      printf "  %-10s %d active\n" "$_p" "$_w_count"
    fi
  done < <(canonical_players)
  if [ "$_worker_total" = 0 ]; then dim "no kanban workers running"; fi
  if [ "$_stale_total" -gt 0 ]; then
    warn "$_stale_total stale worker(s) — run \`landfolk stop\` or \`landfolk fix clean\` to sweep:"
    printf "%b" "$_stale_lines"
  fi

  h1 "roster"
  if [ -s "$ROSTER_FILE" ]; then
    sed 's/^/  /' "$ROSTER_FILE"
  else
    dim "no active roster (run: scripts/landfolk start)"
  fi

  # Roster drift detection: compare what's in the roster file against what's
  # actually a live in-game bot (canonical username + /health returns
  # connected=true). Two kinds of drift:
  #   (a) live bot NOT in roster file — the bot is running but the roster
  #       doesn't reflect it. The pauser/dispatcher won't see it as eligible
  #       for routing.
  #   (b) roster entry with NO live bot — stale roster line; bot died or
  #       was killed without `landfolk stop`.
  # Both are advisory; the user fixes via `landfolk enable <p>` (add to
  # roster) or `landfolk disable <p>` (remove from roster).
  local _roster_set=""
  if [ -s "$ROSTER_FILE" ]; then
    _roster_set="$(awk '{print $1}' "$ROSTER_FILE" | tr '\n' ' ')"
  fi
  local _drift_live_not_roster="" _drift_roster_not_live=""
  local _cp _expected_port _ok
  while IFS= read -r _cp; do
    [ -z "$_cp" ] && continue
    _expected_port="$(player_api_port "$_cp")"
    [ -z "$_expected_port" ] && continue
    _ok=0
    curl -sf -m 1 "http://127.0.0.1:$_expected_port/health" 2>/dev/null \
      | python3 -c "import sys,json;d=json.load(sys.stdin);sys.exit(0 if d.get('connected') else 1)" 2>/dev/null && _ok=1
    if [ "$_ok" = 1 ]; then
      case " $_roster_set " in *" $_cp "*) : ;; *) _drift_live_not_roster+="$_cp " ;; esac
    fi
  done < <(canonical_players)
  for _entry in $_roster_set; do
    _expected_port="$(player_api_port "$_entry")"
    [ -z "$_expected_port" ] && continue
    _ok=0
    curl -sf -m 1 "http://127.0.0.1:$_expected_port/health" 2>/dev/null \
      | python3 -c "import sys,json;d=json.load(sys.stdin);sys.exit(0 if d.get('connected') else 1)" 2>/dev/null && _ok=1
    [ "$_ok" = 0 ] && _drift_roster_not_live+="$_entry "
  done
  if [ -n "$_drift_live_not_roster" ] || [ -n "$_drift_roster_not_live" ]; then
    warn "roster drift detected:"
    [ -n "$_drift_live_not_roster" ] && echo "    live bots NOT in roster: ${C_BOLD}$_drift_live_not_roster${C_RST} (run \`landfolk enable <player>\` to add)"
    [ -n "$_drift_roster_not_live" ] && echo "    roster lists DOWN players: ${C_BOLD}$_drift_roster_not_live${C_RST} (run \`landfolk start --players <p>\` or \`landfolk disable <p>\`)"
  fi

  echo
  echo "${C_DIM}── help ──${C_RST}"
  echo "  ${C_DIM}lifecycle guide:  docs/guides/landfolk-lifecycle.md${C_RST}"
  echo "  ${C_DIM}commands:         scripts/landfolk --help${C_RST}"
  echo "  ${C_DIM}per-bot logs:     scripts/landfolk logs <player>${C_RST}"
  echo "  ${C_DIM}board delta:      scripts/board-recent.py --ticks 5${C_RST}"
  echo "  ${C_DIM}base inventory:   scripts/base-inventory.py${C_RST}"
  echo "  ${C_DIM}role tags in ps:  ps -ax -o pid,command | grep landfolk:${C_RST}"
}

cmd_logs() {
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '24,38p' "$0" | sed -E 's/^# ?//'; return 0
  fi
  local target="agents"
  if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then target="$1"; shift; fi
  local lines=20 follow="" profiles_csv="" no_bot=0 no_color=0 quiet=0 show_reasoning=0 no_timestamps=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --tail) lines="$2"; shift 2 ;;
      --follow|-f) follow="-f"; shift ;;
      --profiles|--players) profiles_csv="$2"; shift 2 ;;
      --no-bot-logs) no_bot=1; shift ;;
      --no-color) no_color=1; shift ;;
      --quiet|-q) quiet=1; shift ;;
      --reasoning) show_reasoning=1; shift ;;
      --no-timestamps) no_timestamps=1; shift ;;
      *) err "unknown flag: $1"; return 1 ;;
    esac
  done
  case "$target" in
    agents|"")
      local agg_args=( --profiles "${profiles_csv:-$(roster_players | paste -sd, - || echo "$PLAYERS_DEFAULT")}" --tail "$lines" )
      [ "$no_bot"   = 1 ] && agg_args+=( --no-bot-logs )
      [ "$no_color" = 1 ] && agg_args+=( --no-color )
      [ "$quiet"    = 1 ] && agg_args+=( --quiet )
      [ "$show_reasoning" = 1 ] && agg_args+=( --reasoning )
      [ "$no_timestamps" = 1 ] && agg_args+=( --no-timestamps )
      exec python3 -u "$SCRIPT_DIR/scripts/landfolk-logs-aggregate.py" "${agg_args[@]}"
      ;;
    flint|mason|gatherer|steward|barley) tail $follow -n "$lines" "$LOG_DIR/bot-$target.log" ;;
    listener)   tail $follow -n "$lines" "$LOG_DIR/steward-chat-listener.log" ;;
    supervisor) tail $follow -n "$lines" "$LOG_DIR/steward-supervisor.log" ;;
    pauser)     tail $follow -n "$lines" "$LOG_DIR/inactive-cards-pauser.log" ;;
    chat-wake)  tail $follow -n "$lines" "$LOG_DIR/landfolk-chat-wake.log" ;;
    gateway)    tail $follow -n "$lines" "$LOG_DIR/gateway.log" 2>/dev/null || warn "no gateway log file" ;;
    *) err "unknown logs target: $target"; return 1 ;;
  esac
}

cmd_cognition() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    export)
      local profile="${1:-}"; shift || true
      [ -z "$profile" ] && { err "cognition export needs <player>"; return 1; }
      exec python3 "$SCRIPT_DIR/scripts/landfolk-cognition-export.py" "$profile" "$@"
      ;;
    backfill)
      local profiles_csv=""
      local extra=( --once --session-hours 72 )
      while [ $# -gt 0 ]; do
        case "$1" in
          --profiles|--players) profiles_csv="$2"; shift 2 ;;
          --session-hours) extra+=( --session-hours "$2" ); shift 2 ;;
          --backfill-bot-log) extra+=( --backfill-bot-log ); shift ;;
          *) err "unknown flag: $1"; return 1 ;;
        esac
      done
      local prof_arg
      prof_arg="${profiles_csv:-$(roster_players | paste -sd, - || echo "$PLAYERS_DEFAULT")}"
      exec python3 -u "$SCRIPT_DIR/scripts/landfolk-cognition-record.py" --profiles "$prof_arg" "${extra[@]}"
      ;;
    -h|--help|help|"")
      echo "Usage:"
      echo "  scripts/landfolk cognition export <player> [--grep REGEX] [--tail N] [-o DIR]"
      echo "  scripts/landfolk cognition backfill [--profiles a,b,c] [--backfill-bot-log] [--session-hours N]"
      return 0
      ;;
    *) err "unknown cognition subcommand: $sub (try export|backfill)"; return 1 ;;
  esac
}

cmd_chat() {
  local player="${1:-}"; shift || true
  [ -z "$player" ] && { err "chat needs <player> \"message\""; return 1; }
  local pl; pl="$(parse_players_csv "$player")" || return 1
  local port; port="$(player_api_port "$pl")"
  [ -z "$port" ] && { err "no port for $pl"; return 1; }
  MC_API_URL="http://localhost:$port" "$SCRIPT_DIR/bin/mc" chat "$*" 2>&1 | head -3
}

cmd_fix() {
  local issue="${1:-}"; shift || true
  case "$issue" in
    reconnect)
      local player="${1:-}"; [ -z "$player" ] && { err "fix reconnect needs a player"; return 1; }
      local pl; pl="$(parse_players_csv "$player")" || return 1
      local port; port="$(player_api_port "$pl")"
      curl -sf -X POST "http://127.0.0.1:$port/connect" -H "Content-Type: application/json" -d '{"force":true}' >/dev/null \
        && ok "force-reconnect sent to $pl (:$port)" \
        || err "force-reconnect FAILED for $pl"
      ;;
    clean)
      h1 "cleaning orphan node bots + stale pidfiles"
      # Build the set of tracked PIDs from existing pidfiles.
      local tracked=""
      for f in /tmp/hermescraft/landfolk-control/bot-*.pid; do
        [ -f "$f" ] && tracked="$tracked $(cat "$f")"
      done
      # Inspect each `node server.js` process and decide:
      #   A. Tracked PID → leave alone.
      #   B. Untracked but the process IS a live landfolk bot — i.e. its env
      #      has MC_USERNAME=<canonical> + API_PORT listens on /health and
      #      returns the same username — then it's a live bot whose pidfile
      #      drifted. **Don't kill it; regenerate the pidfile instead.**
      #   C. Otherwise truly orphan (no canonical username, or port silent) — kill.
      #
      # Earlier behaviour killed live bots whenever pidfiles drifted (re44
      # 2026-05-24 bug). This guards against that false positive.
      pgrep -af "node server.js" 2>/dev/null | while read -r pid _; do
        if echo "$tracked" | grep -qw "$pid"; then
          continue
        fi
        local _env _user _port _user_lower _expected_port _health_user
        _env="$(ps eww -p "$pid" -o command= 2>/dev/null)"
        _user="$(printf '%s' "$_env" | tr ' ' '\n' | awk -F= '$1=="MC_USERNAME"{print $2; exit}')"
        _port="$(printf '%s' "$_env" | tr ' ' '\n' | awk -F= '$1=="API_PORT"{print $2; exit}')"
        _user_lower="$(printf '%s' "$_user" | tr '[:upper:]' '[:lower:]')"
        if [ -n "$_user_lower" ] && is_canonical_player "$_user_lower"; then
          # Process claims to be a canonical landfolk bot — verify via /health.
          _expected_port="$(player_api_port "$_user_lower")"
          if [ -n "$_port" ] && [ "$_port" = "$_expected_port" ]; then
            _health_user="$(curl -sf -m 1 "http://127.0.0.1:$_port/health" 2>/dev/null \
              | python3 -c "import sys,json;print((json.load(sys.stdin).get('username') or '').lower())" 2>/dev/null)"
            if [ "$_health_user" = "$_user_lower" ]; then
              # Live bot — regenerate the pidfile so future `clean` won't
              # mis-tag it again.
              echo "$pid" > "/tmp/hermescraft/landfolk-control/bot-${_user_lower}.pid"
              ok "kept live bot pid=$pid (${_user_lower} :$_port) — pidfile regenerated"
              continue
            fi
          fi
        fi
        kill "$pid" 2>/dev/null && warn "killed orphan node bot pid=$pid (user=${_user:-?} port=${_port:-?})"
      done
      for f in /tmp/hermescraft/landfolk-control/*.pid "$STATE_DIR"/*.pid; do
        [ -f "$f" ] || continue
        local pid; pid="$(cat "$f")"
        if ! kill -0 "$pid" 2>/dev/null; then
          rm -f "$f" && dim "removed stale pidfile $(basename "$f")"
        fi
      done
      # Sweep stale kanban workers — those whose task is no longer in
      # `running` on the board. Live workers are left alone.
      local _running_tids=""
      if command -v hermes >/dev/null 2>&1; then
        _running_tids="$(hermes kanban --board landfolk-ops list 2>/dev/null | awk '$3=="running"{print $2}' | paste -sd, -)"
      fi
      local _p _pid _tid
      while IFS= read -r _p; do
        [ -z "$_p" ] && continue
        while read -r _pid _tid; do
          [ -z "$_pid" ] && continue
          if [ -z "$_running_tids" ] || ! echo ",$_running_tids," | grep -q ",$_tid,"; then
            kill "$_pid" 2>/dev/null && warn "killed stale worker $_p pid=$_pid task=$_tid"
          fi
        done < <(kanban_workers_for "$_p")
      done < <(canonical_players)
      ok "clean done"
      ;;
    tp)
      local player="${1:-}" x="${2:-}" y="${3:-}" z="${4:-}"
      [ -z "$player$x$y$z" ] && { err "fix tp needs <player> <x> <y> <z>"; return 1; }
      ssh -n ubuntu-host "sudo docker exec minecraft rcon-cli 'tp $player $x $y $z'" 2>&1 | head -2 | sed 's/^/  /'
      ;;
    unstick)
      local player="${1:-}"; [ -z "$player" ] && { err "fix unstick needs a player"; return 1; }
      local pl; pl="$(parse_players_csv "$player")" || return 1
      local port; port="$(player_api_port "$pl")"
      curl -sf -X POST "http://127.0.0.1:$port/connect" -H "Content-Type: application/json" -d '{"force":true}' >/dev/null \
        && ok "force-reconnect sent to $pl" \
        || err "force-reconnect FAILED for $pl"
      sleep 2
      reclaim_running "$pl"
      ok "unstick complete"
      ;;
    *) err "unknown fix issue: ${issue:-<none>} (valid: reconnect|clean|tp|unstick)"; return 1 ;;
  esac
}

# ─── Version checking ──────────────────────────────────────────────────────
# Helper: probe a running bot for its build info. Returns one of:
#   "ok|<sha7> (<branch>, <clean|DIRTY>)"      — bot has /health.build, no drift
#   "drift|<sha7>|<drift_reason>"              — bot has /health.build, drift detected
#   "no-build-field|<reason>"                  — bot is reachable but lacks /health.build
#                                                (pre-build-info code; restart required)
#   "unreachable"                              — /health didn't respond
_probe_bot_build() {
  local port="$1"
  local resp
  resp="$(curl -sf "http://127.0.0.1:$port/health" 2>/dev/null)"
  if [ -z "$resp" ]; then
    echo "unreachable"
    return
  fi
  printf '%s' "$resp" | python3 -c "
import sys, json
try:
  d = json.load(sys.stdin)
except Exception as e:
  print(f'no-build-field|invalid /health JSON: {e}')
  sys.exit(0)
if 'build' not in d or d['build'] is None:
  print('no-build-field|bot is running pre-build-info code (restart to enable build tracking)')
  sys.exit(0)
b = d['build']
spawn = b.get('spawn') or {}
sc = (spawn.get('commit') or '')[:7] or '?'
br = spawn.get('branch') or '?'
sd = 'DIRTY' if spawn.get('dirty') else 'clean'
if b.get('drift'):
  reason = b.get('drift_reason') or 'drift'
  print(f'drift|{sc}|{reason}')
else:
  print(f'ok|{sc} ({br}, {sd})')
" 2>/dev/null || echo "no-build-field|/health parse error"
}

# Helper: compare a bot process's start time against the mtime of key bot
# source files. Returns "ok" or "stale|<reason>". Works regardless of whether
# the bot has /health.build — uses filesystem mtime as ground truth.
_check_bot_mtime_drift() {
  local profile="$1"
  # The watchdog body launched the bot with exec -a "landfolk:bot-loop:<Name>"
  # where <Name> is the canonical capitalized profile. Try the original
  # capitalization first, then a case-insensitive search.
  local cap profile_lower pid
  profile_lower="$(echo "$profile" | tr '[:upper:]' '[:lower:]')"
  cap="$(echo "$profile_lower" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
  pid="$(pgrep -f "landfolk:bot-loop:${cap}" 2>/dev/null | head -1)"
  if [ -z "$pid" ]; then
    pid="$(pgrep -fi "landfolk:bot-loop:${profile_lower}" 2>/dev/null | head -1)"
  fi
  if [ -z "$pid" ]; then
    echo "stale|cannot find bot process for $profile"
    return
  fi

  # Process start time as epoch seconds (parse `ps -o lstart=`).
  local pstart
  pstart="$(ps -o lstart= -p "$pid" 2>/dev/null | python3 -c 'import sys,time; s=sys.stdin.read().strip();
try:
  print(int(time.mktime(time.strptime(s))))
except Exception:
  pass' 2>/dev/null)"
  if [ -z "$pstart" ]; then
    echo "stale|cannot determine bot process start time (pid=$pid)"
    return
  fi

  # Find the newest source mtime that affects the bot. Restrict to bot/ and
  # the launcher / watchdog control script.
  local newest_line newest_mtime newest_file
  newest_line="$(find "$SCRIPT_DIR/bot" "$SCRIPT_DIR/scripts/landfolk-control.sh" \
      -type f \( -name '*.js' -o -name '*.mjs' -o -name '*.sh' \) 2>/dev/null \
      | xargs stat -f '%m %N' 2>/dev/null \
      | sort -rn | head -1)"
  newest_mtime="${newest_line%% *}"
  newest_file="${newest_line#* }"
  if [ -z "$newest_mtime" ]; then
    echo "ok"
    return
  fi
  if [ "$newest_mtime" -gt "$pstart" ]; then
    local delta=$(( newest_mtime - pstart ))
    local rel="${newest_file##$SCRIPT_DIR/}"
    echo "stale|source $rel is ${delta}s newer than bot process (started $(date -r "$pstart" '+%H:%M:%S'))"
  else
    echo "ok"
  fi
}

cmd_version() {
  local fail=0
  h1 "build / version check"
  echo "  repo HEAD:  $(cd "$SCRIPT_DIR" && git rev-parse HEAD 2>/dev/null || echo '?') ($(cd "$SCRIPT_DIR" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?'))"
  local _dirty
  _dirty="$(cd "$SCRIPT_DIR" && git status --porcelain -uno 2>/dev/null | head -1)"
  if [ -n "$_dirty" ]; then
    echo "  repo state: ${C_WARN}DIRTY${C_RST} (uncommitted changes — bot would report dirty=true if restarted now)"
  else
    echo "  repo state: clean"
  fi
  echo
  for p in $(canonical_players); do
    local port
    port="$(player_api_port "$p")"
    [ -z "$port" ] && continue
    local build_status mtime_status
    build_status="$(_probe_bot_build "$port")"
    case "$build_status" in
      unreachable)
        dim "$p: not running (port $port)"
        ;;
      ok\|*)
        ok "$p: ${build_status#ok|}"
        ;;
      drift\|*)
        local rest="${build_status#drift|}"
        local sha="${rest%%|*}"
        local reason="${rest#*|}"
        warn "$p: DRIFT ($sha): $reason"
        fail=$((fail + 1))
        ;;
      no-build-field\|*)
        local reason="${build_status#no-build-field|}"
        # Fall back to mtime comparison
        mtime_status="$(_check_bot_mtime_drift "$p")"
        case "$mtime_status" in
          ok)
            warn "$p: $reason"
            dim "  (source mtimes match process start — restart will pick up build-info next time)"
            ;;
          stale\|*)
            warn "$p: STALE — $reason"
            dim "  ${mtime_status#stale|}"
            fail=$((fail + 1))
            ;;
        esac
        ;;
      *)
        warn "$p: unexpected probe result: $build_status"
        ;;
    esac
  done
  echo
  if [ "$fail" = 0 ]; then
    ok "all bots are on the latest code"
  else
    err "$fail bot(s) need restart to pick up new code"
    dim "remedy: scripts/landfolk restart <name>     (single bot)"
    dim "        scripts/landfolk restart players    (all rostered bots)"
    dim "        scripts/landfolk restart all        (full session bounce)"
  fi
  return "$fail"
}

# ─── Deploy (sync repo → runtime locations) ────────────────────────────────
# Push the repo's authoritative skills + SOULs + profile config out to all
# the runtime locations Hermes reads from. Idempotent. Safe to call any
# time; if nothing changed on disk the targets are byte-identical and the
# cp's are effectively no-ops.
#
# What this syncs:
#   - skills/*.md            → ~/.hermes/profiles/<bot>/skills/gaming/<name>/SKILL.md
#                              (via sync-skills.sh, MANIFEST-driven)
#   - skills/kanban-worker.md → ~/.hermes/skills/devops/kanban-worker/SKILL.md
#                              AND ~/.hermes/profiles/<bot>/skills/devops/kanban-worker/SKILL.md
#                              (via install_kanban_worker_skill — our override of
#                              the Hermes platform skill)
#   - prompts/landfolk/*.md  → read fresh at every Steward / worker spawn,
#                              no copy needed
#   - SOUL-landfolk.md       → continuous-agent home (copied at start by
#                              landfolk-control.sh; not by this command)
#   - profile config patches → ~/.hermes/profiles/<bot>/config.yaml
#                              (via patch_kanban_config, patch_env_passthrough)
#
# Continuous-loop SOULs + skills are synced ON-DEMAND at agent start by
# landfolk-control.sh. This command handles the kanban-worker profile-side
# pieces that are NOT auto-synced today.
cmd_deploy() {
  local dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1; shift ;;
      -h|--help)
        cat <<'EOF'
landfolk deploy — sync repo → runtime locations

Pushes authoritative repo state (skills, profile SOULs, kanban-worker
override, profile config patches) out to:
  ~/.hermes/skills/devops/kanban-worker/SKILL.md          (user-dir override)
  ~/.hermes/profiles/<bot>/skills/devops/kanban-worker/SKILL.md (per-profile)
  ~/.hermes/profiles/<bot>/skills/gaming/<name>/SKILL.md  (MANIFEST skills)
  ~/.hermes/profiles/<bot>/SOUL.md                        (worker / steward SOULs)
  ~/.hermes/profiles/<bot>/config.yaml                    (passthrough, max_turns)

Idempotent. Run this any time the repo's skills or profile config changes.
Continuous-agent SOULs are NOT touched (they sync at start via landfolk-control.sh).

Options:
  --dry-run    Show what would change, don't write.
EOF
        return 0 ;;
      *) err "unknown flag: $1"; return 1 ;;
    esac
  done

  local setup="$SCRIPT_DIR/scripts/setup-landfolk-profiles.sh"
  if [ ! -x "$setup" ]; then
    err "$setup not found or not executable"
    return 1
  fi

  h1 "deploying skills + SOULs + config to runtime locations"
  if [ "$dry_run" = 1 ]; then
    DRY_RUN=true "$setup" --dry-run --apply-config
  else
    "$setup" --apply-config
  fi
  local rc=$?
  if [ "$rc" = 0 ]; then
    ok "deploy complete"
  else
    err "deploy exited rc=$rc — review output above"
  fi
  return "$rc"
}

# ─── Diagnostics mode ──────────────────────────────────────────────────────
# Incremental startup with per-phase verification. Brings up each piece on
# its own (gateway → dispatcher → steward → workers → daemons), checking the
# health of each before moving on. Use after a code change or whenever you
# want to spot startup failures precisely instead of running `landfolk start`
# and hoping.
#
# Phases are skippable; default sleep between phases is 8s. With --fail-fast
# the run aborts on the first failed check; without it, each failure is
# logged and we continue so you see the full picture.
cmd_diagnostics() {
  local fail_fast=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --fail-fast) fail_fast=1; shift ;;
      -h|--help)
        cat <<'HELP'
landfolk diagnostics — REPORT fleet health. Read-only, idempotent.

Does NOT start, stop, or deploy anything. Each phase is a check; failures
print a "→ remedy: <command>" hint so you can act explicitly.

Options:
  --fail-fast    Stop at first FAIL (default: full report)

Phases (all read-only):
  1. Pre-flight        what's up vs down (gateway, dispatcher, daemons, bots)
  2. Skills sync       repo skills/kanban-worker.md matches user-dir override
  3. Hermes gateway    running check
  4. Kanban dispatcher running check
  5. Steward           connection + HP-alert env wiring + build version
  6. Workers           connection + POS_DIAG armed + build + watchdog heartbeat
  7. Daemons           listener + chat-wake running checks
  8. Summary           failure count + remedy hints

Exit code = number of failures (0 = healthy).

To actually fix things:
  landfolk start [--players a,b,c]    # start gateway/dispatcher/bots/daemons
  landfolk deploy                     # sync repo skills/SOULs to runtime
  landfolk restart <player|all>       # bounce a stuck bot
HELP
        return 0 ;;
      *) err "unknown flag: $1"; return 1 ;;
    esac
  done

  local diag_failures=0
  _diag_check() {
    local label="$1" cond="$2" hint="${3:-}"
    if eval "$cond" >/dev/null 2>&1; then
      ok "$label"
    else
      err "$label"
      [ -n "$hint" ] && dim "→ remedy: $hint"
      diag_failures=$((diag_failures + 1))
      [ "$fail_fast" = 1 ] && return 99
    fi
  }

  # ── Phase 1: pre-flight inventory ────────────────────────────────────────
  h1 "phase 1 — pre-flight inventory"
  echo "  rostered:  $(roster_players | tr '\n' ' ')"
  echo "  log dir:   $LOG_DIR"
  echo "  state dir: $STATE_DIR"
  local _up_now=0 _total=0
  for _p in $(canonical_players); do
    local _port; _port="$(player_api_port "$_p")"
    [ -z "$_port" ] && continue
    _total=$((_total + 1))
    curl -sf "http://127.0.0.1:$_port/health" >/dev/null 2>&1 && _up_now=$((_up_now + 1))
  done
  echo "  bots reachable: $_up_now/$_total"

  # ── Phase 2: skills sync ─────────────────────────────────────────────────
  h1 "phase 2 — skills sync"
  local _src="$SCRIPT_DIR/skills/kanban-worker.md"
  local _user_skill="$HOME/.hermes/skills/devops/kanban-worker/SKILL.md"
  if [ ! -f "$_src" ]; then
    warn "repo skills/kanban-worker.md missing"
  elif [ ! -f "$_user_skill" ]; then
    err "user-dir kanban-worker SKILL missing"
    dim "→ remedy: scripts/landfolk deploy"
    diag_failures=$((diag_failures + 1))
    [ "$fail_fast" = 1 ] && { _diag_summary; return "$diag_failures"; }
  else
    local _src_md5 _user_md5
    _src_md5="$(md5 -q "$_src" 2>/dev/null || md5sum "$_src" 2>/dev/null | awk '{print $1}')"
    _user_md5="$(md5 -q "$_user_skill" 2>/dev/null || md5sum "$_user_skill" 2>/dev/null | awk '{print $1}')"
    if [ "$_src_md5" = "$_user_md5" ]; then
      ok "kanban-worker SKILL synced (repo == user-dir)"
    else
      err "kanban-worker SKILL DRIFT — repo vs user-dir hash mismatch"
      dim "→ remedy: scripts/landfolk deploy"
      diag_failures=$((diag_failures + 1))
      [ "$fail_fast" = 1 ] && { _diag_summary; return "$diag_failures"; }
    fi
    # Check profile copies for drift (informational, doesn't fail run)
    local _drift_profiles=""
    for _pdir in "$HOME"/.hermes/profiles/*/skills/devops/kanban-worker/SKILL.md; do
      [ -f "$_pdir" ] || continue
      local _pmd5
      _pmd5="$(md5 -q "$_pdir" 2>/dev/null || md5sum "$_pdir" 2>/dev/null | awk '{print $1}')"
      if [ "$_pmd5" != "$_src_md5" ]; then
        local _pname
        _pname="$(echo "$_pdir" | sed -E 's|.*/profiles/([^/]+)/.*|\1|')"
        _drift_profiles="${_drift_profiles:+$_drift_profiles, }$_pname"
      fi
    done
    [ -n "$_drift_profiles" ] && { warn "profile copies drift: $_drift_profiles"; dim "→ remedy: scripts/landfolk deploy"; }
  fi

  # ── Phase 3: hermes gateway ──────────────────────────────────────────────
  h1 "phase 3 — hermes gateway"
  _diag_check "hermes gateway running" "gateway_running" \
              "scripts/landfolk start  (or: nohup hermes gateway run --replace &)"
  [ "${diag_failures:-0}" -gt 0 ] && [ "$fail_fast" = 1 ] && { _diag_summary; return "$diag_failures"; }

  # ── Phase 4: kanban dispatcher ───────────────────────────────────────────
  h1 "phase 4 — kanban dispatcher"
  _diag_check "kanban dispatcher running" \
              "pgrep -f 'landfolk-dispatcher\\.sh' >/dev/null 2>&1" \
              "scripts/landfolk start  (or: nohup scripts/landfolk-dispatcher.sh > /tmp/hermescraft/dispatcher.log 2>&1 &)"
  [ "${diag_failures:-0}" -gt 0 ] && [ "$fail_fast" = 1 ] && { _diag_summary; return "$diag_failures"; }

  # ── Phase 5: steward ─────────────────────────────────────────────────────
  h1 "phase 5 — steward"
  local _sport; _sport="$(player_api_port "steward")"
  if [ -n "$_sport" ]; then
    if curl -sf "http://127.0.0.1:$_sport/health" 2>/dev/null \
         | python3 -c "import sys,json;sys.exit(0 if json.load(sys.stdin).get('connected') else 1)" 2>/dev/null; then
      ok "steward connected (port $_sport)"
      if grep -q 'DANGER_AUTOREACT_BROADCAST_CHAT=false' "$0" 2>/dev/null; then
        ok "steward HP-alert chat suppression wired in launcher source"
      else
        warn "DANGER_AUTOREACT_BROADCAST_CHAT=false override not found in $0"
      fi
      local _sstatus
      _sstatus="$(_probe_bot_build "$_sport")"
      _diag_render_build "steward" "$_sstatus"
    else
      err "steward not connected (no /health response on port $_sport)"
      dim "→ remedy: scripts/landfolk start --players steward"
      diag_failures=$((diag_failures + 1))
      [ "$fail_fast" = 1 ] && { _diag_summary; return "$diag_failures"; }
    fi
  fi

  # ── Phase 6: workers ─────────────────────────────────────────────────────
  h1 "phase 6 — workers"
  local p port
  for p in $(canonical_players); do
    [ "$p" = "steward" ] && continue
    port="$(player_api_port "$p")"
    [ -z "$port" ] && continue
    if curl -sf "http://127.0.0.1:$port/health" 2>/dev/null \
         | python3 -c "import sys,json;sys.exit(0 if json.load(sys.stdin).get('connected') else 1)" 2>/dev/null; then
      ok "$p connected (port $port)"
      grep -q '\[POS_DIAG\] instrumentation armed' "$LOG_DIR/bot-$p.log" 2>/dev/null \
        && ok "$p POS_DIAG instrumentation armed" \
        || warn "$p POS_DIAG line not yet in log"
      local _bstatus
      _bstatus="$(_probe_bot_build "$port")"
      _diag_render_build "$p" "$_bstatus"
      local _hb="$LOG_DIR/watchdog-$p.heartbeat"
      if [ -e "$_hb" ]; then
        local _now _mt _age
        _now="$(date +%s)"
        _mt="$(stat -f %m "$_hb" 2>/dev/null || stat -c %Y "$_hb" 2>/dev/null || echo "$_now")"
        _age=$(( _now - _mt ))
        if [ "$_age" -lt 30 ]; then
          ok "$p watchdog heartbeat fresh (${_age}s)"
        else
          warn "$p watchdog heartbeat stale (${_age}s)"
        fi
      else
        warn "$p watchdog heartbeat file not yet present"
      fi
    else
      # Bot is rostered but not connected — only flag if rostered
      local _stored
      _stored="$(roster_mode_for "$p" 2>/dev/null)"
      if [ -n "$_stored" ]; then
        err "$p not connected (in roster, expected up)"
        dim "→ remedy: scripts/landfolk start --players $p"
        diag_failures=$((diag_failures + 1))
        [ "$fail_fast" = 1 ] && { _diag_summary; return "$diag_failures"; }
      else
        dim "$p not connected (not in active roster — OK)"
      fi
    fi
  done

  # ── Phase 7: daemons ─────────────────────────────────────────────────────
  h1 "phase 7 — daemons"
  for d in listener chat-wake; do
    if daemon_alive "$d"; then
      ok "$d running (pid $(daemon_pid "$d"))"
    else
      err "$d not running"
      dim "→ remedy: scripts/landfolk restart $d"
      diag_failures=$((diag_failures + 1))
      [ "$fail_fast" = 1 ] && { _diag_summary; return "$diag_failures"; }
    fi
  done
  dim "supervisor + pauser + cognition are opt-in — not checked"

  # ── Phase 8: summary ─────────────────────────────────────────────────────
  _diag_summary
  return "$diag_failures"
}

# Render the build/version status from _probe_bot_build into log line + counter.
_diag_render_build() {
  local label="$1" status="$2"
  case "$status" in
    ok\|*)            ok   "$label build: ${status#ok|}" ;;
    drift\|*)
      local rest="${status#drift|}"
      warn "$label build: DRIFT (${rest%%|*}): ${rest#*|}"
      diag_failures=$((diag_failures + 1))
      dim "→ remedy: scripts/landfolk restart $label"
      ;;
    no-build-field\|*)
      local mt
      mt="$(_check_bot_mtime_drift "$label")"
      case "$mt" in
        ok)
          warn "$label build: pre-build-info code"
          dim "→ remedy: scripts/landfolk restart $label  (to enable build tracking)"
          ;;
        stale\|*)
          warn "$label build: STALE — ${mt#stale|}"
          diag_failures=$((diag_failures + 1))
          dim "→ remedy: scripts/landfolk restart $label"
          ;;
      esac
      ;;
    unreachable) warn "$label build: /health unreachable" ;;
    *)           warn "$label build: $status" ;;
  esac
}

# Print the diagnostics summary block. Pulled out so phase early-exits can
# call it before returning.
_diag_summary() {
  h1 "phase 8 — summary"
  if [ "${diag_failures:-0}" = 0 ]; then
    ok "all checks passed — fleet is healthy"
  else
    err "${diag_failures:-0} failure(s) — see remedies above"
    dim "  scripts/landfolk status   for a richer board / kanban / daemon view"
  fi
  echo
}

cmd_players() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list)
      printf "  %-10s %-12s %-6s %-9s %-10s %s\n" "player" "role" "port" "viewer" "in-roster" "model"
      local p role port vport in_roster model
      while IFS= read -r p; do
        [ -z "$p" ] && continue
        role="$(player_role "$p")"
        port="$(player_api_port "$p")"
        vport="$(player_viewer_port "$p")"
        model="$(player_model "$p")"
        if roster_players | grep -qx "$p"; then
          in_roster="$(roster_mode_for "$p")"
        else
          in_roster="-"
        fi
        printf "  %-10s %-12s %-6s :%-8s %-10s %s\n" "$p" "${role:-?}" "${port:-?}" "${vport:-?}" "$in_roster" "${model:-?}"
      done < <(canonical_players)
      ;;
    show)
      local p="${1:-}"; [ -z "$p" ] && { err "players show needs a name"; return 1; }
      local pl; pl="$(parse_players_csv "$p")" || return 1
      local stored eff
      stored="$(roster_mode_for "$pl")"
      eff="$(resolve_mode "$pl" "$stored")"
      printf "  %-12s %s\n" "player:"   "$pl"
      printf "  %-12s %s\n" "role:"     "$(player_role "$pl")"
      printf "  %-12s %s\n" "port:"     "$(player_api_port "$pl")"
      printf "  %-12s :%s\n" "viewer:"   "$(player_viewer_port "$pl")"
      printf "  %-12s %s\n" "model:"    "$(player_model "$pl")"
      printf "  %-12s %s\n" "provider:" "$(player_provider "$pl")"
      printf "  %-12s %s (effective: %s)\n" "mode:" "$stored" "$eff"
      if roster_players | grep -qx "$pl"; then
        printf "  %-12s %s\n" "in roster:" "yes ($ROSTER_FILE)"
      else
        printf "  %-12s %s\n" "in roster:" "no — `landfolk enable $pl` to add"
      fi
      ;;
    *) err "unknown players subcommand: $sub (valid: list|show)"; return 1 ;;
  esac
}

cmd_defaults() {
  h1 "landfolk defaults"
  echo "  ${C_BOLD}players${C_RST}"
  echo "    PLAYERS_DEFAULT       $PLAYERS_DEFAULT"
  echo "    (used only when the roster is empty; otherwise roster wins)"
  echo
  echo "  ${C_BOLD}mode${C_RST}"
  echo "    LANDFOLK_DEFAULT_MODE $DEFAULT_MODE"
  echo "    auto rules:           role=orchestrator → continuous, else → kanban"
  local p role eff
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    role="$(player_role "$p")"
    eff="$(resolve_mode "$p" auto)"
    printf "       %-10s role=%-12s auto→%s\n" "$p" "${role:-?}" "$eff"
  done < <(canonical_players)
  echo
  echo "  ${C_BOLD}daemons${C_RST}"
  echo "    on by default:        listener, chat-wake"
  echo "    opt-in:               supervisor, pauser (omit --without to start them manually via restart)"
  echo "    disable listener:     --without listener|daemons"
  echo "    disable chat-wake:    --without chat-wake|daemons"
  echo
  echo "  ${C_BOLD}gateway${C_RST}"
  echo "    on by default:        no (observe only)"
  echo "    manage explicitly:    start --with-gateway | stop --with-gateway"
  echo
  echo "  ${C_BOLD}state${C_RST}"
  echo "    LOG_DIR               $LOG_DIR"
  echo "    STATE_DIR             $STATE_DIR"
  echo "    ROSTER_FILE           $ROSTER_FILE"
  if [ -s "$ROSTER_FILE" ]; then
    echo "    current roster:"
    sed 's/^/      /' "$ROSTER_FILE"
  else
    echo "    current roster:       (empty — `landfolk start` will seed from PLAYERS_DEFAULT)"
  fi
}

# ─── Dispatch ──────────────────────────────────────────────────────────────

CMD="${1:-}"; shift || true
# Make resolver paths available to subprocesses (status --json uses these)
export AGENT_MODELS_JSON RESOLVER

case "$CMD" in
  start)            cmd_start "$@" ;;
  stop)             cmd_stop "$@" ;;
  enable)           cmd_enable "$@" ;;
  disable)          cmd_disable "$@" ;;
  restart)          cmd_restart "$@" ;;
  status|st)        cmd_status "$@" ;;
  diagnostics|diag) cmd_diagnostics "$@" ;;
  deploy)           cmd_deploy "$@" ;;
  version|ver)      cmd_version "$@" ;;
  logs|log)         cmd_logs "$@" ;;
  cognition)        cmd_cognition "$@" ;;
  chat)             cmd_chat "$@" ;;
  fix)              cmd_fix "$@" ;;
  players|player)   cmd_players "$@" ;;
  defaults)         cmd_defaults "$@" ;;
  -h|--help|help|"") usage 0 ;;
  *) err "unknown command: $CMD"; usage 1 ;;
esac
