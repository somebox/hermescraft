#!/usr/bin/env python3
"""board — single brief-output kanban viewer for landfolk-ops.

Replaces ad-hoc combinations of `hermes kanban show / list / stats` +
`scripts/board-recent.py` with one command and lean defaults. Most calls
return < 30 lines. Use `--full` only when you need the event log.

Usage:
    scripts/board                       # overview: stats + recent + workers
    scripts/board show <id>             # lean card: header, body, diagnostics, last comment, last run
    scripts/board show <id> --full      # passthrough to hermes kanban show (~150 lines)
    scripts/board list                  # one-line-per-task, all non-done
    scripts/board list --status blocked
    scripts/board list --assignee flint
    scripts/board recent [--ticks 5]    # delegates to scripts/board-recent.py
    scripts/board stats                 # delegates to hermes kanban stats

Why this exists:
    `hermes kanban show <id>` averages ~150 lines / ~3000 tokens per call,
    of which 70-80% is historical event/run log. Steward observed running
    out of cycle budget reading these. This wrapper exposes the actionable
    25 lines (id, body, last comment, last run) as the default.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from datetime import datetime
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
BOARD = os.environ.get("HERMES_KANBAN_BOARD", "landfolk-ops")


def _run(cmd: list[str], timeout: int = 15) -> tuple[int, str, str]:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout after {timeout}s"


def _kanban_json(verb: str, *args: str, timeout: int = 15):
    """Run `hermes kanban --board <board> <verb> ... --json`, return parsed dict/list or None."""
    rc, out, err = _run(["hermes", "kanban", "--board", BOARD, verb, *args, "--json"], timeout=timeout)
    if rc != 0:
        print(f"# kanban {verb} failed (rc={rc}): {err.strip()[:200]}", file=sys.stderr)
        return None
    try:
        return json.loads(out)
    except json.JSONDecodeError as e:
        print(f"# kanban {verb} returned non-JSON: {e}", file=sys.stderr)
        return None


def _ts_ago(ts: int | None) -> str:
    if not ts:
        return "?"
    delta = int(datetime.now().timestamp()) - int(ts)
    if delta < 60:
        return f"{delta}s ago"
    if delta < 3600:
        return f"{delta // 60}m ago"
    if delta < 86400:
        return f"{delta // 3600}h{(delta % 3600) // 60}m ago"
    return f"{delta // 86400}d ago"


def _truncate(s: str, n: int) -> str:
    s = (s or "").strip().replace("\n", " ")
    return s if len(s) <= n else s[:n - 1] + "…"


# ─── subcommands ────────────────────────────────────────────────────────────


def cmd_show(args):
    """Lean card view: header + body + diagnostics + last comment + last run."""
    if args.full:
        os.execvp("hermes", ["hermes", "kanban", "--board", BOARD, "show", args.task_id])
    data = _kanban_json("show", args.task_id)
    if data is None:
        sys.exit(1)

    # show --json returns: {task, comments, events, runs, parents, children, latest_summary}
    task = data.get("task") or {}
    tid = task.get("id", args.task_id)
    title = task.get("title", "")
    status = task.get("status", "?")
    assignee = task.get("assignee") or "—"
    body = (task.get("body") or "").rstrip()
    diagnostics = data.get("diagnostics") or task.get("diagnostics") or []
    comments = data.get("comments") or []
    runs = data.get("runs") or []
    parents = data.get("parents") or task.get("parents") or []
    children = data.get("children") or task.get("children") or []

    print(f"{tid}  {title}")
    print(f"  status:    {status}")
    print(f"  assignee:  {assignee}")
    if parents:
        # parents may be list of dicts or strings
        parent_ids = [p.get("id", str(p)) if isinstance(p, dict) else str(p) for p in parents]
        print(f"  parents:   {', '.join(parent_ids)}")
    if children:
        child_ids = [c.get("id", str(c)) if isinstance(c, dict) else str(c) for c in children]
        more = f" (+{len(child_ids) - 5} more)" if len(child_ids) > 5 else ""
        print(f"  children:  {', '.join(child_ids[:5])}{more}")

    # Body — keep first 30 lines max (rare card needs more inline)
    if body:
        print("  body:")
        body_lines = body.split("\n")
        for line in body_lines[:30]:
            print(f"    {line}")
        if len(body_lines) > 30:
            print(f"    … (+{len(body_lines) - 30} more body lines; use --full to see all)")

    # Diagnostics (always show — they're actionable)
    if diagnostics:
        print(f"  diagnostics ({len(diagnostics)}):")
        for d in diagnostics[:3]:
            sev = d.get("severity", "info")
            msg = d.get("message", d.get("title", ""))
            print(f"    [{sev}] {_truncate(msg, 100)}")

    # Last comment only (one of N — most recent is what matters)
    if comments:
        c = comments[-1]
        author = c.get("author", "?")
        ts = c.get("created_at")
        body_one = _truncate((c.get("body") or "").replace("\n", " "), 120)
        print(f"  last comment ({author}, {_ts_ago(ts)}, {len(comments)} total):")
        print(f"    {body_one}")

    # Last run only
    if runs:
        r = runs[-1]
        outcome = r.get("outcome", "?")
        ts = r.get("started_at") or r.get("created_at")
        summary = _truncate((r.get("summary") or r.get("error") or ""), 120)
        n = len(runs)
        print(f"  last run #{n}: {outcome} ({_ts_ago(ts)})")
        if summary:
            print(f"    {summary}")

    print(f"  # full view: scripts/board show {tid} --full   (≈150 lines)")


def cmd_list(args):
    """One-line-per-task listing. Defaults to all non-done statuses."""
    statuses = args.status.split(",") if args.status else ["triage", "todo", "ready", "running", "blocked"]
    rows = []
    for s in statuses:
        flags = ["--status", s]
        if args.assignee:
            flags.extend(["--assignee", args.assignee])
        data = _kanban_json("list", *flags)
        if data is None:
            continue
        # The list endpoint returns array or {tasks: [...]}
        tasks = data if isinstance(data, list) else (data.get("tasks") or [])
        for t in tasks:
            rows.append({
                "id": t.get("id", "?"),
                "status": t.get("status", s),
                "assignee": t.get("assignee", "?") or "—",
                "title": t.get("title", ""),
                "priority": t.get("priority", 50),
            })

    if not rows:
        print(f"# no cards match (statuses={','.join(statuses)}{(' assignee=' + args.assignee) if args.assignee else ''})")
        return

    # Group + sort by status
    order = ["running", "ready", "todo", "blocked", "triage"]
    rows.sort(key=lambda r: (order.index(r["status"]) if r["status"] in order else 99, -r["priority"], r["id"]))

    print(f"# board={BOARD}  rows={len(rows)}")
    cur_status = None
    for r in rows:
        if r["status"] != cur_status:
            cur_status = r["status"]
            print(f"# ── {cur_status} ──")
        title = _truncate(r["title"], 72)
        print(f"  {r['id']}  {r['assignee']:<10}  p{r['priority']:>2}  {title}")


def cmd_recent(args):
    """Delegate to scripts/board-recent.py."""
    cmd = ["python3", str(REPO_ROOT / "scripts" / "board-recent.py")]
    if args.ticks is not None:
        cmd.extend(["--ticks", str(args.ticks)])
    if args.since:
        cmd.extend(["--since", args.since])
    if args.assignee:
        cmd.extend(["--assignee", args.assignee])
    os.execvp(cmd[0], cmd)


def cmd_stats(args):
    """Brief stats (counts by status + assignee). Delegates to `hermes kanban stats`."""
    os.execvp("hermes", ["hermes", "kanban", "--board", BOARD, "stats"])


def cmd_overview(args):
    """No-arg default: stats + recent (3 ticks) + idle/active workers."""
    print(f"# board={BOARD}  ({datetime.now().strftime('%H:%M:%S')})")
    print()
    print("# ── stats ──")
    rc, out, _ = _run(["hermes", "kanban", "--board", BOARD, "stats"])
    if rc == 0:
        # Trim the verbose "By assignee:" section if present; keep "By status:"
        for line in out.splitlines():
            if line.startswith("By assignee:"):
                break
            print("  " + line)
    print()
    print("# ── recent (3 ticks) ──")
    rc, out, _ = _run(["python3", str(REPO_ROOT / "scripts" / "board-recent.py"), "--ticks", "3"])
    if rc == 0:
        # Show only the body rows + worker footer (skip the leading header line)
        for line in out.splitlines():
            print("  " + line if line else line)


# ─── dispatch ───────────────────────────────────────────────────────────────


def main():
    ap = argparse.ArgumentParser(
        description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = ap.add_subparsers(dest="cmd")

    p_show = sub.add_parser("show", help="Lean view of one card (id + body + last comment + last run)")
    p_show.add_argument("task_id")
    p_show.add_argument("--full", action="store_true", help="passthrough to `hermes kanban show` (~150 lines)")
    p_show.set_defaults(func=cmd_show)

    p_list = sub.add_parser("list", help="One-line-per-task listing")
    p_list.add_argument("--status", help="comma-separated statuses (default: all non-done)")
    p_list.add_argument("--assignee", help="filter by assignee")
    p_list.set_defaults(func=cmd_list)

    p_recent = sub.add_parser("recent", help="event delta since last cycle (board-recent.py)")
    p_recent.add_argument("--ticks", type=int, default=5)
    p_recent.add_argument("--since")
    p_recent.add_argument("--assignee")
    p_recent.set_defaults(func=cmd_recent)

    p_stats = sub.add_parser("stats", help="counts by status (hermes kanban stats)")
    p_stats.set_defaults(func=cmd_stats)

    args = ap.parse_args()
    if args.cmd is None:
        cmd_overview(args)
        return 0
    return args.func(args) or 0


if __name__ == "__main__":
    sys.exit(main())
