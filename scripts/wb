#!/usr/bin/env python3
"""wb — worker board proxy. Tiny, scope-locked CLI for landfolk workers.

Workers should never reach raw `hermes kanban`. Their card id is in the
env var ``HERMES_KANBAN_TASK`` (set by the dispatcher); every verb here
acts on that one card unless ``--task <id>`` is passed for ad-hoc use.

Verbs
-----
  wb context [--json]              # active card + epic + siblings + (best-effort bot pose)
  wb comment "<text>"              # append a comment
  wb close   [--result "..."]      # mark the card done
  wb block   "<reason>"            # park the card; status stays running, lane → blocked
  wb escalate "<reason>"           # like block but prefixes "[!ESCALATED] " for Steward's NEEDS REVIEW lane

The wedge bug — `--parent` vs `--epic` vs `--depends-on` conflation that
stalled three genesis runs — is structurally impossible from this surface:
``wb`` cannot create cards or edit graph edges.

Implementation
--------------
- READS  → direct sqlite (read-only URI) on the same DB the dispatcher uses.
- WRITES → shell-out to ``hermes kanban`` so events / lock cascades stay
           consistent with the dispatcher.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Optional

BOARD = os.environ.get("HERMES_KANBAN_BOARD", "landfolk-ops")
DB_PATH = Path(
    os.environ.get(
        "HERMES_KANBAN_DB",
        str(Path.home() / ".hermes" / "kanban" / "boards" / BOARD / "kanban.db"),
    )
)
ESCALATE_PREFIX = "[!ESCALATED] "
EPIC_TRAILER_PREFIX = "epic: "
SIBLING_LIMIT = 12
COMMENT_LIMIT = 5
BODY_PREVIEW_LINES = 20


# ─── helpers ──────────────────────────────────────────────────────────────


def _die(msg: str, code: int = 1) -> None:
    print(f"wb: {msg}", file=sys.stderr)
    sys.exit(code)


def _active_task_id(cli_value: Optional[str]) -> str:
    if cli_value:
        return cli_value
    tid = os.environ.get("HERMES_KANBAN_TASK", "").strip()
    if not tid:
        _die(
            "no active card — HERMES_KANBAN_TASK is unset and --task wasn't passed.\n"
            "  (Workers are dispatched with this env var set; if you're testing "
            "manually, pass --task <id>.)"
        )
    return tid


def _db() -> sqlite3.Connection:
    if not DB_PATH.exists():
        _die(f"kanban DB not found at {DB_PATH}")
    # Plain open (not the `mode=ro` URI form). Read-only is a soft
    # contract — all our queries are SELECT — but the URI form rejects
    # opens with "unable to open database file" when the WAL sidecars
    # are mid-transition right after a writer commits. Same fix pattern
    # as scripts/kanban (7484b31).
    conn = sqlite3.connect(str(DB_PATH), timeout=5.0)
    conn.row_factory = sqlite3.Row
    return conn


def _run(cmd: list[str], timeout: int = 30) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def _hermes(*args: str, timeout: int = 30) -> str:
    """Run ``hermes kanban --board <board> <args>``; raise on failure."""
    cmd = ["hermes", "kanban", "--board", BOARD, *args]
    proc = _run(cmd, timeout=timeout)
    if proc.returncode != 0:
        msg = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        _die(f"hermes kanban {args[0] if args else ''} failed: {msg}",
             code=proc.returncode or 1)
    return proc.stdout


def _epic_from_body(body: Optional[str]) -> Optional[str]:
    """Extract ``epic: <id>`` from a body trailer."""
    if not body or "---" not in body:
        return None
    parts = body.rsplit("\n---\n", 1)
    if len(parts) != 2:
        if body.startswith("---\n"):
            parts = ["", body[4:]]
        else:
            return None
    for line in parts[1].splitlines():
        line = line.strip()
        if line.startswith(EPIC_TRAILER_PREFIX):
            v = line[len(EPIC_TRAILER_PREFIX):].strip()
            return v or None
    return None


def _resolve_epic_id(conn: sqlite3.Connection, task_row: sqlite3.Row) -> Optional[str]:
    """Find the epic this card belongs to.

    Prefers the body trailer (``epic: <id>``); falls back to the first
    parent edge whose title carries an ``[EPIC]`` marker.
    """
    epic = _epic_from_body(task_row["body"])
    if epic:
        return epic
    rows = conn.execute(
        """
        SELECT p.id, p.title FROM task_links l
          JOIN tasks p ON p.id = l.parent_id
         WHERE l.child_id = ?
         ORDER BY p.created_at
        """,
        (task_row["id"],),
    ).fetchall()
    for r in rows:
        if "[EPIC]" in (r["title"] or ""):
            return r["id"]
    return None


def _fetch_siblings(conn: sqlite3.Connection, epic_id: str, exclude_id: str) -> list[sqlite3.Row]:
    """Cards under the same epic — by trailer scan OR by link.

    Returns title + status + assignee only. Bodies are deliberately NOT
    selected: workers should not see other cards' bodies (scope-locked).
    """
    trailer_hits = conn.execute(
        "SELECT id, title, status, assignee FROM tasks "
        "WHERE body LIKE ? AND id != ? "
        "ORDER BY status, created_at LIMIT ?",
        (f"%{EPIC_TRAILER_PREFIX}{epic_id}%", exclude_id, SIBLING_LIMIT * 2),
    ).fetchall()
    link_hits = conn.execute(
        """
        SELECT c.id, c.title, c.status, c.assignee
          FROM task_links l JOIN tasks c ON c.id = l.child_id
         WHERE l.parent_id = ? AND c.id != ?
         ORDER BY c.status, c.created_at LIMIT ?
        """,
        (epic_id, exclude_id, SIBLING_LIMIT * 2),
    ).fetchall()
    seen: set[str] = set()
    merged: list[sqlite3.Row] = []
    for r in (*trailer_hits, *link_hits):
        if r["id"] in seen:
            continue
        seen.add(r["id"])
        merged.append(r)
        if len(merged) >= SIBLING_LIMIT:
            break
    return merged


def _fetch_comments(conn: sqlite3.Connection, task_id: str, limit: int) -> list[sqlite3.Row]:
    return list(
        conn.execute(
            "SELECT author, body, created_at FROM task_comments "
            "WHERE task_id = ? ORDER BY created_at DESC LIMIT ?",
            (task_id, limit),
        )
    )


def _fetch_bot_pose(timeout: float = 1.0) -> Optional[dict]:
    """Best-effort GET against the local Steve API (default :3001).

    Returns None on any failure — workers without a bot bound to them
    still get a useful ``wb context`` (just no pose block).
    """
    port = os.environ.get("STEVE_PORT", os.environ.get("MC_HTTP_PORT", "3001"))
    url = f"http://127.0.0.1:{port}/status?lean=true&preserve=true"
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="replace"))
        return data
    except (urllib.error.URLError, urllib.error.HTTPError, ConnectionError,
            TimeoutError, json.JSONDecodeError, OSError):
        return None


# ─── command: context ────────────────────────────────────────────────────


def _build_context(task_id: str) -> dict:
    with _db() as conn:
        row = conn.execute(
            "SELECT id, title, body, assignee, status, priority, "
            "       created_at, started_at, "
            "       location_x, location_y, location_z, size "
            "FROM tasks WHERE id = ?",
            (task_id,),
        ).fetchone()
        if row is None:
            _die(f"no card {task_id} on board {BOARD}")
        epic_id = _resolve_epic_id(conn, row)
        epic_row = None
        siblings: list[sqlite3.Row] = []
        if epic_id:
            epic_row = conn.execute(
                "SELECT id, title, body, status FROM tasks WHERE id = ?",
                (epic_id,),
            ).fetchone()
            siblings = _fetch_siblings(conn, epic_id, task_id)
        comments = _fetch_comments(conn, task_id, COMMENT_LIMIT)

    visible_body = (row["body"] or "")
    if "\n---\n" in visible_body:
        visible_body = visible_body.rsplit("\n---\n", 1)[0].rstrip("\n")

    epic_data = None
    if epic_row:
        epic_visible = (epic_row["body"] or "")
        if "\n---\n" in epic_visible:
            epic_visible = epic_visible.rsplit("\n---\n", 1)[0].rstrip("\n")
        epic_data = {
            "id": epic_row["id"],
            "title": epic_row["title"],
            "status": epic_row["status"],
            "body_summary": "\n".join(epic_visible.splitlines()[:3]),
        }

    pose = _fetch_bot_pose()

    return {
        "card": {
            "id": row["id"],
            "title": row["title"],
            "status": row["status"],
            "assignee": row["assignee"],
            "priority": row["priority"] or 0,
            "size": row["size"],
            "location": (
                {"x": row["location_x"], "y": row["location_y"], "z": row["location_z"]}
                if any(row[k] is not None for k in ("location_x", "location_y", "location_z"))
                else None
            ),
            "body": visible_body,
        },
        "epic": epic_data,
        "siblings": [
            {"id": s["id"], "title": s["title"], "status": s["status"], "assignee": s["assignee"]}
            for s in siblings
        ],
        "comments": [
            {"author": c["author"], "body": c["body"], "created_at": c["created_at"]}
            for c in comments
        ],
        "bot_pose": pose,
        "board": BOARD,
    }


def _render_context(ctx: dict) -> str:
    card = ctx["card"]
    out: list[str] = []
    out.append(f"Card {card['id']} ── {card['status']} ── {card['assignee'] or '—'}")
    loc = card.get("location")
    size = card.get("size") or "—"
    loc_s = f"{loc['x']},{loc['y']},{loc['z']}" if loc else "—"
    out.append(f"  {card['title']}")
    out.append(f"  size: {size}  ·  location: {loc_s}  ·  priority: {card['priority']}")
    if card["body"]:
        out.append("  body:")
        for line in card["body"].splitlines()[:BODY_PREVIEW_LINES]:
            out.append(f"    {line}")
        more = len(card["body"].splitlines()) - BODY_PREVIEW_LINES
        if more > 0:
            out.append(f"    … (+{more} more lines)")
    if ctx["comments"]:
        out.append(f"  comments (last {len(ctx['comments'])}):")
        for c in reversed(ctx["comments"]):
            body_first = (c["body"] or "").splitlines()[0] if c["body"] else ""
            if len(body_first) > 110:
                body_first = body_first[:109] + "…"
            out.append(f"    [{c['author']}] {body_first}")

    if ctx["epic"]:
        e = ctx["epic"]
        out.append("")
        out.append(f"Epic {e['id']} ── {e['status']}")
        out.append(f"  {e['title']}")
        if e["body_summary"]:
            for line in e["body_summary"].splitlines():
                out.append(f"  | {line}")

    if ctx["siblings"]:
        out.append("")
        out.append(f"Siblings in this epic ({len(ctx['siblings'])}):")
        for s in ctx["siblings"]:
            assignee = s["assignee"] or "—"
            title = (s["title"] or "")
            if len(title) > 56:
                title = title[:55] + "…"
            out.append(f"  {s['id']}  [{s['status']:<8}] {assignee:<10} {title}")

    pose = ctx["bot_pose"]
    if pose:
        out.append("")
        out.append("Bot state:")
        p = pose.get("position") or pose.get("pos") or {}
        if p:
            out.append(f"  pos {p.get('x')},{p.get('y')},{p.get('z')}")
        hp = pose.get("health")
        food = pose.get("food")
        held = pose.get("heldItem") or pose.get("holding")
        bits = []
        if hp is not None:
            bits.append(f"hp {hp}")
        if food is not None:
            bits.append(f"food {food}")
        if held:
            bits.append(f"holding {held}")
        if bits:
            out.append(f"  {' · '.join(bits)}")

    return "\n".join(out)


def cmd_context(args: argparse.Namespace) -> int:
    task_id = _active_task_id(args.task)
    ctx = _build_context(task_id)
    # Phase 10 PR-K: side-effect the card-body-coord stash on every
    # context call so workers don't have to remember to run a second
    # command. Best-effort; never fails the context output.
    try:
        _stash_card_coord_side_effect(task_id, ctx)
    except Exception:
        pass
    if args.json:
        print(json.dumps(ctx, default=str))
    else:
        print(_render_context(ctx))
    return 0


# ─── command: comment / close / block / escalate ─────────────────────────


def cmd_comment(args: argparse.Namespace) -> int:
    task_id = _active_task_id(args.task)
    _hermes("comment", task_id, args.text, timeout=15)
    print(f"# commented on {task_id}")
    return 0


def cmd_close(args: argparse.Namespace) -> int:
    task_id = _active_task_id(args.task)
    argv: list[str] = ["complete", task_id]
    if args.result:
        argv.extend(["--result", args.result])
    _hermes(*argv, timeout=20)
    # Phase 10 PR-K: clear the stash so the next card's coord doesn't leak.
    _clear_card_coord_stash()
    print(f"# closed {task_id}")
    return 0


def cmd_block(args: argparse.Namespace) -> int:
    task_id = _active_task_id(args.task)
    _hermes("block", task_id, args.reason, timeout=15)
    _clear_card_coord_stash()
    print(f"# blocked {task_id}: {args.reason}")
    return 0


def cmd_escalate(args: argparse.Namespace) -> int:
    """Reuse the block event with a marker prefix so Steward's board view
    can surface a NEEDS REVIEW lane without a schema change."""
    task_id = _active_task_id(args.task)
    reason = f"{ESCALATE_PREFIX}{args.reason}"
    _hermes("block", task_id, reason, timeout=15)
    _clear_card_coord_stash()
    print(f"# escalated {task_id}: {args.reason}")
    return 0


# ─── Phase 9 PR-D — card-body coord stash ────────────────────────────────
#
# `wb stash-coord` extracts the active card's primary build coord and writes
# it to $HERMES_HOME/task-body-coord.json. The bot's `mc mark` action reads
# this file at mark-action time to detect structure-mark drift (e.g. Mason
# placing `base_foundation` 38 blocks from the pad target — run-5 evidence).
#
# Extraction priority — coord MUST come from a literal `mc <verb>` line,
# NOT from prose like "centered at (X,Y,Z)". The prose-vs-verb-args
# distinction matters because Steward's verb-first card body uses corner
# coords ("mc fill ... 15 101 49 23 101 56") while the prose annotation
# uses the center ("centered at (19,101,52)"). Drift detection keys on the
# verb args; mixing the two would false-positive on every good mark.

_FILL_LINE = re.compile(r"^\s*mc\s+fill\b\s+\S+\s+(-?\d+)\s+(-?\d+)\s+(-?\d+)\s+(-?\d+)\s+(-?\d+)\s+(-?\d+)\b")
_PLACE_LINE = re.compile(r"^\s*mc\s+place\b\s+\S+\s+(-?\d+)\s+(-?\d+)\s+(-?\d+)\b")
_GOTO_MOVE_LINE = re.compile(r"^\s*mc\s+(?:goto|move)\b\s+(-?\d+)\s+(-?\d+)\s+(-?\d+)\b")
_FENCED = re.compile(r"^\s*```")


def extract_card_body_coord(body: Optional[str]) -> Optional[dict]:
    """Pull the first build coord from a card body.

    Returns {"x": int, "y": int, "z": int} or None. Skips fenced code
    blocks (they're examples, not instructions). Falls back to a generic
    coord triple on non-prose lines if no `mc` verb is present, so prose
    cards still get *some* coord for drift detection during the Phase 9
    transition window before PR-A's verb-first rule is universally adopted.
    """
    if not body:
        return None
    in_fence = False
    fallback: Optional[tuple[int, int, int]] = None
    for raw in body.splitlines():
        if _FENCED.match(raw):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = _FILL_LINE.match(raw)
        if m:
            x1, y1, z1, x2, y2, z2 = (int(g) for g in m.groups())
            return {"x": (x1 + x2) // 2, "y": (y1 + y2) // 2, "z": (z1 + z2) // 2}
        m = _PLACE_LINE.match(raw)
        if m:
            return {"x": int(m.group(1)), "y": int(m.group(2)), "z": int(m.group(3))}
        m = _GOTO_MOVE_LINE.match(raw)
        if m:
            return {"x": int(m.group(1)), "y": int(m.group(2)), "z": int(m.group(3))}
        if fallback is None:
            # Prose-fallback triple: require three integers on a non-mc-verb
            # line that doesn't look like a range expression ("Y94-100").
            stripped = raw.strip()
            if stripped and not stripped.startswith("#") and "-" not in stripped[:1]:
                gm = re.search(r"\(?\s*(-?\d+)\s*[,\s]\s*(-?\d+)\s*[,\s]\s*(-?\d+)\s*\)?", stripped)
                if gm and "-" not in stripped[max(0, gm.start() - 2):gm.start()]:
                    fallback = (int(gm.group(1)), int(gm.group(2)), int(gm.group(3)))
    if fallback is not None:
        x, y, z = fallback
        return {"x": x, "y": y, "z": z}
    return None


# Card kinds that should stash a coord. EXPLORE/SCOUT cards are intentionally
# prose-led and don't have a single build target; skip them to avoid stashing
# noise that would false-positive on later structure marks.
#
# Run-7 Step 3 (pr-k-kinds-unify): the kind set lives in
# `scripts/lib/card_kinds.py` so the wb stash filter and the
# `card_body_linter`'s verb-required check can't drift.
try:
    # Normal path when wb is invoked from a checkout root.
    from scripts.lib.card_kinds import VERB_REQUIRED_KINDS as _STASH_KINDS, title_kind_in as _kind_in
except ImportError:
    # Defensive fallback: wb may be on PATH in an isolated worker shell
    # where `scripts` isn't on sys.path. Re-import via the file path the
    # rest of the script computes (`REPO_ROOT`).
    import importlib.util as _ilu
    _spec = _ilu.spec_from_file_location(
        "card_kinds_fallback",
        str((Path(__file__).resolve().parent / "lib" / "card_kinds.py")),
    )
    _mod = _ilu.module_from_spec(_spec)
    assert _spec.loader
    _spec.loader.exec_module(_mod)
    _STASH_KINDS = _mod.VERB_REQUIRED_KINDS
    _kind_in = _mod.title_kind_in


def _card_should_stash(title: str | None) -> bool:
    return _kind_in(title, _STASH_KINDS)


def _stash_path() -> Path | None:
    home = os.environ.get("HERMES_HOME")
    return Path(home) / "task-body-coord.json" if home else None


def _clear_card_coord_stash() -> None:
    """Best-effort delete of the stash file. Called from close/block/escalate
    so the next card's coord doesn't leak. Never raises."""
    p = _stash_path()
    if not p:
        return
    try:
        p.unlink()
    except FileNotFoundError:
        pass
    except Exception:
        pass


def _stash_card_coord_side_effect(task_id: str, ctx: dict) -> dict | None:
    """Phase 10 PR-K — called from `cmd_context` to side-effect the stash
    file. Skips silently when:
      - HERMES_HOME unset (running outside a worker shell)
      - card kind isn't a stash-worthy kind (EXPLORE/SCOUT bodies are prose)
      - body has no extractable coord (verb-first lines or prose fallback)
    Returns the coord dict written, or None if no write happened.
    """
    out_path = _stash_path()
    if not out_path:
        return None
    card = ctx.get("card") or {}
    if not _card_should_stash(card.get("title")):
        # Not a stash kind — leave the prior stash alone. The next CONSTRUCT/
        # SUPPLY/etc. claim will overwrite or close/block/escalate will clear.
        return None
    body = card.get("body") or ""
    coord = extract_card_body_coord(body)
    if coord is None:
        # Stash-worthy kind but body has no extractable coord. Clear any
        # stale prior stash so drift detection doesn't fire on the wrong card.
        try:
            out_path.unlink()
        except FileNotFoundError:
            pass
        return None
    payload = {"task_id": task_id, "coord": coord}
    out_path.write_text(json.dumps(payload), encoding="utf-8")
    return coord


def cmd_stash_coord(args: argparse.Namespace) -> int:
    """Explicit fallback for the side effect in `cmd_context`. Kept so
    operators or pre-existing SOULs that call `wb stash-coord` still work.

    Run-7 Step 3 (PR-K) — mirrors the kind guard in
    `_stash_card_coord_side_effect`. Without this, the explicit path
    happily wrote an EXPLORE coord during run-7 (mason hit the legacy
    SOUL bullet on claim, ran `wb stash-coord` against the NW EXPLORE
    card, the prose-fallback extractor picked up the muster coord, and
    a downstream structure-mark drift warning would have false-fired
    against an EXPLORE-card-derived target).
    """
    home = os.environ.get("HERMES_HOME")
    if not home:
        _die("HERMES_HOME not set — cannot stash coord (worker dispatcher injects this)")
    task_id = _active_task_id(args.task)
    ctx = _build_context(task_id)
    card = ctx.get("card") or {}
    title = card.get("title") or ""
    if not _card_should_stash(title):
        # EXPLORE / SCOUT / un-kinded cards: explicit stash is a no-op so
        # the explicit path can't false-positive while the side-effect
        # path already silently skips. Don't clear a prior stash here —
        # close/block/escalate are the explicit clear channels.
        print(f"# {task_id} ({title!r}) is not a stash-worthy kind — skipping")
        return 0
    body = card.get("body") or ""
    coord = extract_card_body_coord(body)
    out_path = Path(home) / "task-body-coord.json"
    if coord is None:
        try:
            out_path.unlink()
        except FileNotFoundError:
            pass
        print(f"# no extractable coord in card {task_id} body — cleared stash")
        return 0
    payload = {"task_id": task_id, "coord": coord}
    out_path.write_text(json.dumps(payload), encoding="utf-8")
    print(f"# stashed {task_id} coord ({coord['x']},{coord['y']},{coord['z']}) → {out_path}")
    return 0


# ─── dispatch ────────────────────────────────────────────────────────────


def _build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="wb",
        description=__doc__.split("\n\n", 1)[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Environment:\n"
            "  HERMES_KANBAN_TASK   active card id (dispatcher injects this)\n"
            "  HERMES_KANBAN_BOARD  default: landfolk-ops\n"
            "  HERMES_KANBAN_DB     default: ~/.hermes/kanban/boards/<board>/kanban.db\n"
            "  STEVE_PORT           bot HTTP port for pose (default: 3001)\n"
        ),
    )
    ap.add_argument("--task", help="Override HERMES_KANBAN_TASK for ad-hoc use")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("context", help="Show active card + epic + siblings + pose")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_context)

    p = sub.add_parser("comment", help="Append a comment to the active card")
    p.add_argument("text")
    p.set_defaults(func=cmd_comment)

    p = sub.add_parser("close", help="Mark the active card done")
    p.add_argument("--result", help="Short result text")
    p.set_defaults(func=cmd_close)

    p = sub.add_parser("block", help="Block the active card with a reason")
    p.add_argument("reason")
    p.set_defaults(func=cmd_block)

    p = sub.add_parser("escalate", help="Block the active card + flag for Steward review")
    p.add_argument("reason")
    p.set_defaults(func=cmd_escalate)

    p = sub.add_parser(
        "stash-coord",
        help="Extract the card body's primary build coord to $HERMES_HOME/task-body-coord.json (Phase 9 PR-D)",
    )
    p.set_defaults(func=cmd_stash_coord)

    return ap


def main(argv: Optional[list[str]] = None) -> int:
    ap = _build_parser()
    args = ap.parse_args(argv)
    # `hermes` only needs to be on PATH for write verbs.
    if args.cmd in {"comment", "close", "block", "escalate"} and not shutil.which("hermes"):
        _die("`hermes` not on PATH — write verbs need it for event/lock cascades")
    return args.func(args) or 0


# ─── re-exports for tests (keep at bottom so they shadow nothing) ────────
__all__ = ["extract_card_body_coord", "cmd_stash_coord", "main"]


if __name__ == "__main__":
    sys.exit(main())
