+def test_default_spawn_scrubs_leaked_mc_routing_env_vars(kanban_home, monkeypatch):
+    """Phase-12 regression: the gateway-embedded dispatcher inherits the
+    operator-shell env, including `_MC_API_URL_LOCKED` set by Steward's
+    landfolk-control session. If the spawn env carries this through, the
+    mc CLI in the worker routes to the wrong bot port. Confirm
+    `_MC_API_URL_LOCKED`, `MC_API_URL`, and `MC_USERNAME` are scrubbed
+    from the child env before Popen.
+    """
+    captured = {}
+
+    class FakeProc:
+        def __init__(self):
+            self.pid = 99999
+
+    def fake_popen(cmd, **kwargs):
+        captured["env"] = kwargs.get("env", {})
+        return FakeProc()
+
+    monkeypatch.setattr("subprocess.Popen", fake_popen)
+    # Simulate the operator-session leak: Steward's launch state sets
+    # these in the gateway's parent env, which Popen would otherwise
+    # propagate verbatim to the worker.
+    monkeypatch.setenv("_MC_API_URL_LOCKED", "http://localhost:3005")
+    monkeypatch.setenv("MC_API_URL", "http://localhost:3005")
+    monkeypatch.setenv("MC_USERNAME", "Steward")
+
+    conn = kb.connect()
+    try:
+        tid = kb.create_task(conn, title="env scrub test",
+                             assignee="gatherer")
+        task = kb.get_task(conn, tid)
+        workspace = kb.resolve_workspace(task)
+        kb._default_spawn(task, str(workspace))
+    finally:
+        conn.close()
+
+    env = captured["env"]
+    assert "_MC_API_URL_LOCKED" not in env, (
+        "_MC_API_URL_LOCKED leaked to worker env — would route to wrong port"
+    )
+    assert "MC_API_URL" not in env, (
+        "MC_API_URL leaked to worker env — profile .env can't override"
+    )
+    assert "MC_USERNAME" not in env, (
+        "MC_USERNAME leaked to worker env — would mis-attribute chat"
+    )
+
+
