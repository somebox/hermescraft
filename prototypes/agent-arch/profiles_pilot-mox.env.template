# Pilot-mox profile env — bound to Mox Mineflayer bot on :3007.
# Used by the wheat-farm capstone (Session 5b).

# Pin every mc call to Mox's HTTP API. _MC_API_URL_LOCKED tells the
# Hermes terminal-passthrough to refuse env-var overrides at runtime,
# matching the pip/zee pilot template's behaviour.
MC_API_URL=http://127.0.0.1:3007
MC_USERNAME=Mox
_MC_API_URL_LOCKED=1

# OpenRouter — filled in by setup-pilot-mox-live.sh from
# ~/.hermes/profiles/flint/.env (same trick as the pip/zee setup).
OPENROUTER_API_KEY=__OPENROUTER_API_KEY__
